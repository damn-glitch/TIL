    "attribute": {
      "patterns": [
        {
          "name": "meta.attribute.til",
          "begin": "(#\\[)[ \\t]*(?:(cross_level|noinline|requires|effects|ensures|generic|energy|inline|level|lang|pure|cap)(?![\\p{L}\\p{N}_])|([\\p{L}_][\\p{L}\\p{N}_]*))?",
