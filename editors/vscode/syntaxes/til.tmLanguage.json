            "1": {
              "name": "punctuation.definition.attribute.begin.til"
            },
            "2": {
              "name": "entity.other.attribute-name.til"
            },
            "3": {
              "name": "entity.other.attribute-name.unknown.til"
            }
          },
          "end": "(\\])|$",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.end.til"
            }
          },
          "patterns": [
            {
              "include": "#attribute-content"
            }
          ]
        }
      ]
    },
    "attribute-content": {
      "patterns": [
        {
          "begin": "\\[",
          "end": "(\\])|$",
          "patterns": [
            {
              "include": "#attribute-content"
