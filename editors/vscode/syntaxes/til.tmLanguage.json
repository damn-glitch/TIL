{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "Generated by editors/vscode/scripts/gen_grammar.py from the keyword tables of src/til.py - do not edit by hand.",
    "Russian / Latin-script Kazakh keywords are keywords from a #[lang: ru] / #[lang: kk-latn] pragma line on."
  ],
  "name": "TIL",
  "scopeName": "source.til",
  "fileTypes": [
    "til"
  ],
  "patterns": [
    {
      "include": "#pragma-ru-kk-latn"
    },
    {
      "include": "#pragma-ru"
    },
    {
      "include": "#pragma-kk-latn"
    },
    {
      "include": "#base"
