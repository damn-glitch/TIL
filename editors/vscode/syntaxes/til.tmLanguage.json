          ]
        },
        {
          "name": "punctuation.separator.key-value.til",
          "match": ":"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "base": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#expression"
        }
      ]
    },
