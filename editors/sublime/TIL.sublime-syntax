%YAML 1.2
---
# TIL syntax for Sublime Text - generated by editors/vscode/scripts/gen_grammar.py
# from the keyword tables of src/til.py; do not edit by hand.
# Russian / Latin-script Kazakh keywords: from a #[lang: ru] / #[lang: kk-latn] pragma line on.
# Language server: the LSP package with `til lsp` (docs/TIL_LSP.md).
name: 'TIL'
file_extensions: ['til']
scope: 'source.til'
contexts:
  main:
    - match: '^[ \t]*(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:ru)[ \t]*[,\]])(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:kk\-latn)[ \t]*[,\]])(#\[)[ \t]*(lang)[ \t]*(:)([^\]\n]*)(\])'
      captures:
        1: 'meta.attribute.til punctuation.definition.attribute.begin.til'
        2: 'meta.attribute.til entity.other.attribute-name.til'
        3: 'meta.attribute.til punctuation.separator.key-value.til'
        4: 'meta.attribute.til support.constant.language-code.til'
        5: 'meta.attribute.til punctuation.definition.attribute.end.til'
      set: 'main-ru-kk-latn'
    - match: '^[ \t]*(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:ru)[ \t]*[,\]])(#\[)[ \t]*(lang)[ \t]*(:)([^\]\n]*)(\])'
      captures:
        1: 'meta.attribute.til punctuation.definition.attribute.begin.til'
        2: 'meta.attribute.til entity.other.attribute-name.til'
        3: 'meta.attribute.til punctuation.separator.key-value.til'
        4: 'meta.attribute.til support.constant.language-code.til'
        5: 'meta.attribute.til punctuation.definition.attribute.end.til'
      set: 'main-ru'
    - match: '^[ \t]*(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:kk\-latn)[ \t]*[,\]])(#\[)[ \t]*(lang)[ \t]*(:)([^\]\n]*)(\])'
      captures:
        1: 'meta.attribute.til punctuation.definition.attribute.begin.til'
        2: 'meta.attribute.til entity.other.attribute-name.til'
        3: 'meta.attribute.til punctuation.separator.key-value.til'
        4: 'meta.attribute.til support.constant.language-code.til'
        5: 'meta.attribute.til punctuation.definition.attribute.end.til'
      set: 'main-kk-latn'
    - include: 'base'
  main-ru:
    - match: '^[ \t]*(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:kk\-latn)[ \t]*[,\]])(#\[)[ \t]*(lang)[ \t]*(:)([^\]\n]*)(\])'
      captures:
        1: 'meta.attribute.til punctuation.definition.attribute.begin.til'
        2: 'meta.attribute.til entity.other.attribute-name.til'
        3: 'meta.attribute.til punctuation.separator.key-value.til'
        4: 'meta.attribute.til support.constant.language-code.til'
        5: 'meta.attribute.til punctuation.definition.attribute.end.til'
      set: 'main-ru-kk-latn'
    - include: 'keywords-ru'
    - include: 'base'
  main-kk-latn:
    - match: '^[ \t]*(?=#\[[ \t]*lang[ \t]*:(?:[^\],\n]*,)*[ \t]*(?i:ru)[ \t]*[,\]])(#\[)[ \t]*(lang)[ \t]*(:)([^\]\n]*)(\])'
      captures:
        1: 'meta.attribute.til punctuation.definition.attribute.begin.til'
        2: 'meta.attribute.til entity.other.attribute-name.til'
        3: 'meta.attribute.til punctuation.separator.key-value.til'
        4: 'meta.attribute.til support.constant.language-code.til'
        5: 'meta.attribute.til punctuation.definition.attribute.end.til'
      set: 'main-ru-kk-latn'
    - include: 'keywords-kk-latn'
    - include: 'base'
  main-ru-kk-latn:
    - include: 'keywords-ru'
    - include: 'keywords-kk-latn'
    - include: 'base'
  keywords-en:
    - match: '(?<![\p{L}\p{N}_])(struct)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.struct.til'
    - match: '(?<![\p{L}\p{N}_])(enum)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.enum.til'
    - match: '(?<![\p{L}\p{N}_])(trait)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.trait.til'
    - match: '(?<![\p{L}\p{N}_])(type)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.alias.til'
    - match: '(?<![\p{L}\p{N}_])(cap)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.capability.til'
    - match: '(?<![\p{L}\p{N}_])(fn)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.function.til'
    - match: '(?<![\p{L}\p{N}_])(?:resume)(?![\p{L}\p{N}_])(?=[ \t]*\()'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:with)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}_][\p{L}\p{N}_]*[ \t]*(?:\(|=>))'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:match|elif|else|if)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.conditional.til'
    - match: '(?<![\p{L}\p{N}_])(?:while|loop|for|in)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.loop.til'
    - match: '(?<![\p{L}\p{N}_])(?:continue|return|break)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.flow.til'
    - match: '(?<![\p{L}\p{N}_])(?:fallback|timeout|retry)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.recovery.til'
    - match: '(?<![\p{L}\p{N}_])(?:perform|handle)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:invariant|assert|intent)(?![\p{L}\p{N}_])'
      scope: 'keyword.other.contract.til'
    - match: '(?<![\p{L}\p{N}_])(?:import|from|as)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.import.til'
    - match: '(?<![\p{L}\p{N}_])(?:struct|const|trait|enum|impl|type|cap|let|var|fn)(?![\p{L}\p{N}_])'
      scope: 'storage.type.til'
    - match: '(?<![\p{L}\p{N}_])(?:mut|pub)(?![\p{L}\p{N}_])'
      scope: 'storage.modifier.til'
    - match: '(?<![\p{L}\p{N}_])(?:and|not|or)(?![\p{L}\p{N}_])'
      scope: 'keyword.operator.logical.til'
    - match: '(?<![\p{L}\p{N}_])(?:self)(?![\p{L}\p{N}_])'
      scope: 'variable.language.self.til'
    - match: '(?<![\p{L}\p{N}_])(?:False|false|True|true)(?![\p{L}\p{N}_])'
      scope: 'constant.language.boolean.til'
  keywords-kk:
    - match: '(?<![\p{L}\p{N}_])(құрылым)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.struct.til'
    - match: '(?<![\p{L}\p{N}_])(санақ)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.enum.til'
    - match: '(?<![\p{L}\p{N}_])(қасиет)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.trait.til'
    - match: '(?<![\p{L}\p{N}_])(тип)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.alias.til'
    - match: '(?<![\p{L}\p{N}_])(функция)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.function.til'
    - match: '(?<![\p{L}\p{N}_])(?:өңдеу)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}\p{N}_"\''])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:орындау)(?![\p{L}\p{N}_])(?=[ \t]+[\p{L}_])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:жалғау)(?![\p{L}\p{N}_])(?=[ \t]*\()'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:арқылы)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}_][\p{L}\p{N}_]*[ \t]*(?:\(|=>))'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:сәйкестік|әйтпесе|егер)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.conditional.til'
    - match: '(?<![\p{L}\p{N}_])(?:кезінде|ішінде|цикл|үшін)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.loop.til'
    - match: '(?<![\p{L}\p{N}_])(?:жалғастыру|тоқтату|қайтару)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.flow.til'
    - match: '(?<![\p{L}\p{N}_])(?:қайталау)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.recovery.til'
    - match: '(?<![\p{L}\p{N}_])(?:тексеру|ниет)(?![\p{L}\p{N}_])'
      scope: 'keyword.other.contract.til'
    - match: '(?<![\p{L}\p{N}_])(?:ретінде|бастап|импорт)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.import.til'
    - match: '(?<![\p{L}\p{N}_])(?:тұрақтама|айнымалы|тұрақты|функция|құрылым|қасиет|санақ|іске|тип)(?![\p{L}\p{N}_])'
      scope: 'storage.type.til'
    - match: '(?<![\p{L}\p{N}_])(?:өзгермелі|ашық)(?![\p{L}\p{N}_])'
      scope: 'storage.modifier.til'
    - match: '(?<![\p{L}\p{N}_])(?:немесе|емес|және)(?![\p{L}\p{N}_])'
      scope: 'keyword.operator.logical.til'
    - match: '(?<![\p{L}\p{N}_])(?:өзін)(?![\p{L}\p{N}_])'
      scope: 'variable.language.self.til'
    - match: '(?<![\p{L}\p{N}_])(?:ақиқат|жалған)(?![\p{L}\p{N}_])'
      scope: 'constant.language.boolean.til'
    - match: '(?<![\p{L}\p{N}_])(?:басып_шығару|негізгі|ұзындық|енгізу|шығару)(?![\p{L}\p{N}_])'
      scope: 'support.function.builtin.til'
  keywords-kk-latn:
    - match: '(?<![\p{L}\p{N}_])(qurylym)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.struct.til'
    - match: '(?<![\p{L}\p{N}_])(sanaq)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.enum.til'
    - match: '(?<![\p{L}\p{N}_])(qasiet)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.trait.til'
    - match: '(?<![\p{L}\p{N}_])(funktsiya)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.function.til'
    - match: '(?<![\p{L}\p{N}_])(?:ondeu)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}\p{N}_"\''])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:oryndau)(?![\p{L}\p{N}_])(?=[ \t]+[\p{L}_])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:zhalgau)(?![\p{L}\p{N}_])(?=[ \t]*\()'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:arqyly)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}_][\p{L}\p{N}_]*[ \t]*(?:\(|=>))'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:saikestik|aitpese|eger)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.conditional.til'
    - match: '(?<![\p{L}\p{N}_])(?:ishinde|kezinde|tsikl|ushin)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.loop.til'
    - match: '(?<![\p{L}\p{N}_])(?:zhalgastyru|qaitaru|toqtatu)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.flow.til'
    - match: '(?<![\p{L}\p{N}_])(?:qaitalau)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.recovery.til'
    - match: '(?<![\p{L}\p{N}_])(?:tekseru|niet)(?![\p{L}\p{N}_])'
      scope: 'keyword.other.contract.til'
    - match: '(?<![\p{L}\p{N}_])(?:retinde|bastap)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.import.til'
    - match: '(?<![\p{L}\p{N}_])(?:funktsiya|turaqtama|aynymaly|qurylym|turaqty|qasiet|sanaq|iske)(?![\p{L}\p{N}_])'
      scope: 'storage.type.til'
    - match: '(?<![\p{L}\p{N}_])(?:ozgermeli|ashyq)(?![\p{L}\p{N}_])'
      scope: 'storage.modifier.til'
    - match: '(?<![\p{L}\p{N}_])(?:nemese|zhane|emes)(?![\p{L}\p{N}_])'
      scope: 'keyword.operator.logical.til'
    - match: '(?<![\p{L}\p{N}_])(?:ozin)(?![\p{L}\p{N}_])'
      scope: 'variable.language.self.til'
    - match: '(?<![\p{L}\p{N}_])(?:zhalgan|aqiqat)(?![\p{L}\p{N}_])'
      scope: 'constant.language.boolean.til'
    - match: '(?<![\p{L}\p{N}_])(?:basyp_shygaru|negizgi|shygaru|uzyndyq|engizu)(?![\p{L}\p{N}_])'
      scope: 'support.function.builtin.til'
  keywords-ru:
    - match: '(?<![\p{L}\p{N}_])(структура)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.struct.til'
    - match: '(?<![\p{L}\p{N}_])(перечисление)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.enum.til'
    - match: '(?<![\p{L}\p{N}_])(типаж)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.trait.til'
    - match: '(?<![\p{L}\p{N}_])(тип)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.type.alias.til'
    - match: '(?<![\p{L}\p{N}_])(функция)[ \t]+([\p{L}_][\p{L}\p{N}_]*)(?![\p{L}\p{N}_])'
      captures:
        1: 'storage.type.til'
        2: 'entity.name.function.til'
    - match: '(?<![\p{L}\p{N}_])(?:обработать)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}\p{N}_"\''])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:выполнить)(?![\p{L}\p{N}_])(?=[ \t]+[\p{L}_])'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:возобновить)(?![\p{L}\p{N}_])(?=[ \t]*\()'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:с)(?![\p{L}\p{N}_])(?=[ \t]*(?:#.*)?$|[ \t]+[\p{L}_][\p{L}\p{N}_]*[ \t]*(?:\(|=>))'
      scope: 'keyword.control.effect.til'
    - match: '(?<![\p{L}\p{N}_])(?:выбор|иначе|если)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.conditional.til'
    - match: '(?<![\p{L}\p{N}_])(?:пока|цикл|для|в)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.loop.til'
    - match: '(?<![\p{L}\p{N}_])(?:продолжить|прервать|вернуть)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.flow.til'
    - match: '(?<![\p{L}\p{N}_])(?:повторить|таймаут)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.recovery.til'
    - match: '(?<![\p{L}\p{N}_])(?:инвариант|намерение|проверить)(?![\p{L}\p{N}_])'
      scope: 'keyword.other.contract.til'
    - match: '(?<![\p{L}\p{N}_])(?:импорт|как|из)(?![\p{L}\p{N}_])'
      scope: 'keyword.control.import.til'
    - match: '(?<![\p{L}\p{N}_])(?:перечисление|реализация|структура|функция|конст|перем|пусть|типаж|тип)(?![\p{L}\p{N}_])'
      scope: 'storage.type.til'
    - match: '(?<![\p{L}\p{N}_])(?:публ|изм)(?![\p{L}\p{N}_])'
      scope: 'storage.modifier.til'
    - match: '(?<![\p{L}\p{N}_])(?:или|не|и)(?![\p{L}\p{N}_])'
      scope: 'keyword.operator.logical.til'
    - match: '(?<![\p{L}\p{N}_])(?:сам)(?![\p{L}\p{N}_])'
      scope: 'variable.language.self.til'
    - match: '(?<![\p{L}\p{N}_])(?:истина|ложь)(?![\p{L}\p{N}_])'
      scope: 'constant.language.boolean.til'
    - match: '(?<![\p{L}\p{N}_])(?:главная|печать|вывод|длина|ввод)(?![\p{L}\p{N}_])'
      scope: 'support.function.builtin.til'
  base:
    - include: 'comment'
    - include: 'attribute'
    - include: 'expression'
  expression:
    - include: 'keywords-en'
    - include: 'keywords-kk'
    - include: 'string'
    - include: 'number'
    - include: 'builtin'
    - include: 'member'
    - include: 'name'
    - include: 'operator'
  comment:
    - match: '(#)(?!\[).*$'
      scope: 'comment.line.number-sign.til'
      captures:
        1: 'punctuation.definition.comment.til'
  attribute:
    - match: '(#\[)[ \t]*(?:(cross_level|noinline|requires|effects|ensures|generic|energy|inline|level|lang|pure|cap)(?![\p{L}\p{N}_])|([\p{L}_][\p{L}\p{N}_]*))?'
      captures:
        1: 'punctuation.definition.attribute.begin.til'
        2: 'entity.other.attribute-name.til'
        3: 'entity.other.attribute-name.unknown.til'
      push: 'attribute-body'
  attribute-body:
    - meta_scope: 'meta.attribute.til'
    - match: '\]'
      scope: 'punctuation.definition.attribute.end.til'
      pop: true
    - match: '$'
      pop: true
    - match: '\['
      push: 'attribute-bracket'
    - match: ':'
      scope: 'punctuation.separator.key-value.til'
    - include: 'expression'
  attribute-bracket:
    - match: '\]'
      pop: true
    - match: '$'
      pop: true
    - match: '\['
      push: 'attribute-bracket'
    - include: 'expression'
  string:
    - match: '(f)(")'
      captures:
        1: 'storage.type.string.til'
        2: 'punctuation.definition.string.begin.til'
      push: 'fstring-double'
    - match: '(f)('')'
      captures:
        1: 'storage.type.string.til'
        2: 'punctuation.definition.string.begin.til'
      push: 'fstring-single'
    - match: '"'
      scope: 'punctuation.definition.string.begin.til'
      push: 'string-double'
    - match: ''''
      scope: 'punctuation.definition.string.begin.til'
      push: 'string-single'
  string-double:
    - meta_scope: 'string.quoted.double.til'
    - match: '"'
      scope: 'punctuation.definition.string.end.til'
      pop: true
    - match: '$'
      pop: true
    - match: '\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|.)'
      scope: 'constant.character.escape.til'
  fstring-double:
    - meta_scope: 'string.interpolated.double.til'
    - match: '"'
