# arrays.til - push, index, iterate, sum (TIL 3.1 VM benchmark)

main()
    var a = []
    for i in 0..5000
        a.push(i * 37 % 1000)
    var s = 0
    for round in 0..200
        for i in 0..len(a)
            s += a[i]
        a[round] = round
    var t = 0
    for round in 0..100
        for x in a
            t += x
    var b = []
    for round in 0..60
        b = []
        for i in 0..2000
            b.push(a[i] + round)
    print(s)
    print(t)
    print(sum(a))
    print(len(b), b[1999])
