# strings.til - concatenation, f-strings, split, find (TIL 3.1 VM benchmark)

main()
    var count = 0
    var total = 0
    for i in 0..30000
        let s = f"item-{i}:{i * 7}"
        let parts = s.split(":")
        total += len(parts[0]) + parts[1].to_int()
        if s.find("99") >= 0
            count += 1
    var acc = ""
    for i in 0..3000
        acc = acc + str(i % 10)
    var hits = 0
    for i in 0..3000
        if acc.find(str(i % 1000)) >= 0
            hits += 1
    print(count)
    print(total)
    print(len(acc), hits)
