# <<< unicode tables

# code point -> class (the lexer looks up the same few letters again and again)
var UCLS = {}

# entry i of a table: 4 letters of the alphabet '#'..'c' (without '\') = 24 bits
u_entry(t, i)
    var k = i * 4
    var v = 0
    let e = k + 4
    while k < e
        let c = t[k]
        if c > 92
            v = v * 64 + c - 36
        else
            v = v * 64 + c - 35
        k += 1
    return v

# index of the U_LEX run that contains cp (>= 128)
u_run(cp)
    let t = U_LEX
    var lo = 0
    var hi = len(t) / 4 - 1
    while lo < hi
        let mid = (lo + hi + 1) / 2
        if u_entry(t, mid) / 8 <= cp
            lo = mid
        else
            hi = mid - 1
    return lo

# class of a code point >= 128: 0 other, 1 letter (str.isalpha), 2 decimal
# digit (isdecimal), 3 other digit (isdigit), 4 other numeric (isalnum)
uclass(cp)
    let hit = UCLS.get_or(cp, -1)
    if hit >= 0
        return hit
    let k = u_entry(U_LEX, u_run(cp)) % 8
    if len(UCLS) >= 4096
        UCLS = {}
    UCLS[cp] = k
    return k

# value of a decimal digit >= 128 (decimal digits come in runs 0..9)
udigit(cp)
    return (cp - u_entry(U_LEX, u_run(cp)) / 8) % 10

# str.isprintable() of a code point >= 128
uprintable(cp)
    let t = U_PRINT
    var lo = 0
    var hi = len(t) / 4
    while lo < hi
        let mid = (lo + hi) / 2
        if u_entry(t, mid) <= cp
            lo = mid + 1
        else
            hi = mid
    return lo % 2 == 1

# length of the UTF-8 sequence that starts with byte c
ulen(c)
    if c < 128
        return 1
    if c < 224
        return 2
    if c < 240
        return 3
    return 4

# code point of the UTF-8 sequence at s[p] (sources are checked by utf8_error)
ucp(s, p)
    let c = s[p]
    if c < 128
        return c
    if c < 224
        return ((c & 31) << 6) + (s[p + 1] & 63)
    if c < 240
        return ((c & 15) << 12) + ((s[p + 1] & 63) << 6) + (s[p + 2] & 63)
    return ((c & 7) << 18) + ((s[p + 1] & 63) << 12) + ((s[p + 2] & 63) << 6) + (s[p + 3] & 63)

# str.isspace() (regex \s): length of the white space character at s[j], 0 if none
ws_len(s, j)
    let n = len(s)
    if j >= n
        return 0
    let c = s[j]
    if c < 128
        if c == 32 or (c >= 9 and c <= 13) or (c >= 28 and c <= 31)
            return 1
        return 0
    if c == 194 and j + 1 < n and (s[j + 1] == 133 or s[j + 1] == 160)
        return 2
    if c < 225 or c > 227 or j + 2 >= n
        return 0
    let cp = ucp(s, j)
    if cp == 5760 or (cp >= 8192 and cp <= 8202) or cp == 8232 or cp == 8233 or cp == 8239 or cp == 8287 or cp == 12288
        return 3
    return 0

# length of the white space character that ends at s[b - 1], 0 if none
ws_len_before(s, b)
    if b >= 1 and s[b - 1] < 128
        return ws_len(s, b - 1)
    if b >= 2 and ws_len(s, b - 2) == 2
        return 2
    if b >= 3 and ws_len(s, b - 3) == 3
        return 3
    return 0

# a digit for str.isdigit() at s[p]: 0 none, 1 ASCII, 2 other decimal digit,
# 3 other digit (Python's int() and float() reject those)
digit_at(s, p)
    if p >= len(s)
        return 0
    let c = s[p]
    if c < 128
        if c >= 48 and c <= 57
            return 1
        return 0
    let k = uclass(ucp(s, p))
    if k == 2 or k == 3
        return k
    return 0

# Python decodes sources with open(path, encoding="utf-8"): the message of
# its UnicodeDecodeError for invalid UTF-8, None if s is valid
utf8_error(s)
    let n = len(s)
    var i = 0
    while i < n
        let c = s[i]
        if c < 128
            i += 1
        else
            var need = 0
            var lo = 128
            var hi = 191
            if c >= 194 and c <= 223
                need = 1
            elif c >= 224 and c <= 239
                need = 2
                if c == 224
                    lo = 160
                elif c == 237
                    hi = 159
            elif c >= 240 and c <= 244
                need = 3
                if c == 240
                    lo = 144
                elif c == 244
                    hi = 143
            if need == 0
                return [i, utf8_msg(s, i, i + 1, "invalid start byte")]
            var k = 1
            while k <= need
                if i + k >= n
                    return [i, utf8_msg(s, i, i + k, "unexpected end of data")]
                let d = s[i + k]
                if d < lo or d > hi
                    return [i, utf8_msg(s, i, i + k, "invalid continuation byte")]
                lo = 128
                hi = 191
                k += 1
            i += need + 1
    return None

utf8_msg(s, a, b, why)
    if b - a == 1
        return "'utf-8' codec can't decode byte 0x" + hex2(s[a]) + " in position " + str(a) + ": " + why
    return "'utf-8' codec can't decode bytes in position " + str(a) + "-" + str(b - 1) + ": " + why

# read_file / write_file report a failure (or a heap too small for the
# file) as a run-time error: caught here -> [contents] or the error message
try_read(path)
    return retry(1)
        [read_file(path)]
    else
        error

try_write(path, data)
    return retry(1)
        write_file(path, data)
        None
    else
        error

# a source file as Python reads it: valid UTF-8, universal newlines
read_source(path)
    let got = try_read(path)
    if type_of(got) == "str"
        print("tilc: cannot read " + path + " (" + got + ")")
        exit(1)
    var text = got[0]
    let bad = utf8_error(text)
    if bad != None
        var line = 1
        var i = 0
        while i < bad[0]
            if text[i] == 10 or (text[i] == 13 and (i + 1 >= len(text) or text[i + 1] != 10))
                line += 1
            i += 1
        fail_at(line, bad[1])
    if text.contains("\r")
        text = text.replace("\r\n", "\n").replace("\r", "\n")
    return text

# ═══════════════════════════════════════════════════════════════════════════
#                                  LEXER
#   A streaming version of Lexer.tokenize(): lex_next() returns one token at a
#   time; the observable token sequence is the same as the Python lexer's.
# ═══════════════════════════════════════════════════════════════════════════

struct Tok
    t: int
    v: any
    ln: int
    sp: int

struct Lx
    sf: any
    src: str
    n: int
    pos: int
    line: int
    stack: any
    atls: bool
    paren: int
    q: any
    qh: int
    done: bool
    tsp: int
    tln: int

new_lexer(sf, pos, line, stack, atls)
    let src = sf.text
    return Lx { sf: sf, src: src, n: len(src), pos: pos, line: line, stack: stack, atls: atls,
                paren: 0, q: [], qh: 0, done: false, tsp: pos, tln: line }

# `#[lang: ...]` pragmas select extra keyword languages (detect_languages)
skip_ws_any(s, j)
    loop
        let k = ws_len(s, j)
        if k == 0
            return j
        j += k

pragma_at(src, j0, langs)
    let n = len(src)
    var j = skip_ws_any(src, j0)
    if j + 4 > n or src.slice(j, j + 4) != "lang"
        return
    j = skip_ws_any(src, j + 4)
    if j >= n or src[j] != 58
        return
    j = skip_ws_any(src, j + 1)
    var k = j
    while k < n and src[k] != 93
        k += 1
    if k >= n
        return
    for part in src.slice(j, k).split(",")
        let code = strip_ws(part).replace("\u{212A}", "k").to_lower()
        if (code == "kk-latn" or code == "ru") and not langs.contains(code)
            langs.push(code)

setup_languages(src, name)
    var sf = SrcFile { text: src, kwb: {}, alb: {}, name: name }
    var langs = ["en", "kk"]
    let n = len(src)
    var i = 0
    while i < n
        var j = i
        while j < n and (src[j] == 32 or src[j] == 9)
            j += 1
        if j + 1 < n and src[j] == 35 and src[j + 1] == 91
            pragma_at(src, j + 2, langs)
        while i < n and src[i] != 10
            i += 1
        i += 1
    add_keywords(sf, KW_EN, None)
    for code in langs
        if code == "kk"
            add_keywords(sf, KW_KK, AL_KK)
        elif code == "kk-latn"
            add_keywords(sf, kw_kk_latn(), {"basyp_shygaru": "print", "shygaru": "print",
                "negizgi": "main", "uzyndyq": "len", "engizu": "input"})
        elif code == "ru"
            add_keywords(sf, kw_ru(), {"печать": "print", "вывод": "print", "главная": "main",
                "длина": "len", "ввод": "input"})
    return sf

add_keywords(sf, kw, al)
    for k in kw
        let b = k[0]
        if not sf.kwb.has(b)
            sf.kwb[b] = {}
        sf.kwb[b][k] = kw[k]
    if al != None
        for k in al
            let b = k[0]
            if not sf.alb.has(b)
                sf.alb[b] = {}
            sf.alb[b][k] = al[k]

add_tok(lx, t, v)
    lx.q.push(Tok { t: t, v: v, ln: lx.tln, sp: lx.tsp })
    lx.atls = false

add_tok_here(lx, t, v)
    lx.q.push(Tok { t: t, v: v, ln: lx.line, sp: lx.pos })
    lx.atls = false

lex_err(lx, msg)
    fail_at(lx.line, msg)

lex_next(lx)
    while lx.qh >= len(lx.q)
        if lx.qh > 0
            lx.q.clear()
            lx.qh = 0
        lex_step(lx)
    let t = lx.q[lx.qh]
    lx.qh += 1
    return t

# one iteration of the main loop of Lexer.tokenize (may queue several tokens)
lex_step(lx)
    let src = lx.src
    let n = lx.n
    if lx.pos >= n
        if not lx.done
            while len(lx.stack) > 1
                lx.stack.pop()
                add_tok_here(lx, T_DEDENT, None)
            lx.done = true
        add_tok_here(lx, T_EOF, None)
        return
    if lx.atls
        if lx.paren == 0
            lex_indent(lx)
            if lx.pos >= n
                return
        else
            lx.atls = false
            var q = lx.pos
            while q < n and (src[q] == 32 or src[q] == 9)
                q += 1
            lx.pos = q
            if q >= n
                return
    var p = lx.pos
    let c = src[p]
    lx.tsp = p
    lx.tln = lx.line
    if c == 32 or c == 9
        p += 1
        while p < n and (src[p] == 32 or src[p] == 9)
            p += 1
        lx.pos = p
        return
    if c == 35
        if p + 1 < n and src[p + 1] == 91
            lex_attr(lx)
        else
            while p < n and src[p] != 10
                p += 1
            lx.pos = p
        return
    if c == 10
        if lx.paren == 0
            add_tok(lx, T_NEWLINE, "\n")
            lx.atls = true
        lx.pos = p + 1
        lx.line += 1
        return
    if c == 102 and p + 1 < n and (src[p + 1] == 34 or src[p + 1] == 39)
        lx.pos = p + 1
        lex_fstring(lx, src[p + 1])
        return
    if c == 34 or c == 39
        lex_string(lx, c)
        return
    if c >= 48 and c <= 57
        lex_number(lx)
        return
    if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95
        lex_ident(lx)
        return
    if c >= 128
        # str.isdigit() starts a number, str.isalpha() an identifier
        let k = uclass(ucp(src, p))
        if k == 2 or k == 3
            lex_number(lx)
            return
        if k == 1
            lex_ident(lx)
            return
        lex_err(lx, "Unexpected character: '" + src.slice(p, p + ulen(c)) + "'")
    if lex_op(lx, c)
        return
    lex_err(lx, "Unexpected character: '" + src.slice(p, p + 1) + "'")

lex_indent(lx)
    let src = lx.src
    let n = lx.n
    var p = lx.pos
    var spaces = 0
    while p < n
        let c = src[p]
        if c == 32
            spaces += 1
            p += 1
        elif c == 9
            spaces += 4
            p += 1
        elif c == 10
            spaces = 0
            p += 1
            lx.line += 1
        elif c == 35
            if p + 1 < n and src[p + 1] == 91
                break
            while p < n and src[p] != 10
                p += 1
            spaces = 0
        else
            break
    lx.pos = p
    if p >= n
        return
    let st = lx.stack
    let cur = st[len(st) - 1]
    if spaces > cur
        st.push(spaces)
        add_tok_here(lx, T_INDENT, spaces)
    elif spaces < cur
        while len(st) > 1 and st[len(st) - 1] > spaces
            st.pop()
            add_tok_here(lx, T_DEDENT, spaces)
    lx.atls = false

lex_attr(lx)
    let src = lx.src
    let n = lx.n
    var p = lx.pos + 2
    let st = p
    var depth = 1
    var en = -1
    while p < n and depth > 0
        let c = src[p]
        if c == 91
            depth += 1
        elif c == 93
            depth -= 1
            if depth == 0
                en = p
                p += 1
                break
        elif c == 10
            lx.pos = p
            lex_err(lx, "Unterminated attribute")
        p += 1
    if en < 0
        en = p
    lx.pos = p
    let text = strip_ws(src.slice(st, en))
    # `#[lang: ru]` is a lexer pragma (setup_languages), not an attribute
    if len(text) >= 4 and text.slice(0, 4) == "lang"
        let j = skip_ws_any(text, 4)
        if j < len(text) and text[j] == 58
            return
    add_tok(lx, T_ATTRIBUTE, text)

lex_string(lx, quote)
    let src = lx.src
    let n = lx.n
    var p = lx.pos + 1
    var parts = []
    while p < n
        let c = src[p]
        if c == quote
            lx.pos = p + 1
            var v = ""
            if len(parts) == 1
                v = parts[0]
            elif len(parts) > 1
                v = parts.join("")
            if quote == 39 and len(v) > 0 and cp_count(v) == 1
                add_tok(lx, T_CHAR, first_cp(v))
            else
                add_tok(lx, T_STRING, v)
            return
        if c == 92
            lx.pos = p
            parts.push(lex_escape(lx))
            p = lx.pos
        elif c == 10
            lx.pos = p
            lex_err(lx, "Unterminated string")
        else
            let st = p
            p += 1
            while p < n
                let d = src[p]
                if d == quote or d == 92 or d == 10
                    break
                p += 1
            parts.push(src.slice(st, p))
    lx.pos = p
    lex_err(lx, "Unterminated string")

# white space for int() at s[j]: ASCII white space or Unicode white space
# (int() reads the latter as a space), 0 if none
int_ws(s, j, b)
    if j >= b
        return 0
    let c = s[j]
    if c < 128
        if c == 32 or (c >= 9 and c <= 13)
            return 1
        return 0
    return ws_len(s, j)

# Python's int(s[a:b], 16) for \u{...} (white space around, a sign, a 0x prefix,
# single underscores between digits, other Unicode decimal digits): the value
# (capped above 0x10FFFF), or -1 if int() or chr() raises
py_int16(s, a, b)
    var i = a
    loop
        let k = int_ws(s, i, b)
        if k == 0
            break
        i += k
    var neg = false
    if i < b and (s[i] == 43 or s[i] == 45)
        neg = s[i] == 45
        i += 1
    # a 0x prefix (int() has turned any decimal zero into '0' first)
    var z = 0
    if i < b and s[i] == 48
        z = 1
    elif digit_at(s, i) == 2 and digit_value(s, i) == 0
        z = ulen(s[i])
    if z > 0 and i + z < b and (s[i + z] == 120 or s[i + z] == 88)
        i += z + 1
        if i < b and s[i] == 95
            i += 1
    var v = 0
    var digits = 0
    var prev_us = true
    while i < b
        let c = s[i]
        var k = 1
        if c == 95
            if prev_us
                return -1
            prev_us = true
        else
            var d = -1
            if c < 128
                d = hex_val(c)
            elif digit_at(s, i) == 2
                d = digit_value(s, i)
                k = ulen(c)
            if d < 0
                break
            if v <= 1114111
                v = v * 16 + d
            digits += 1
            prev_us = false
        i += k
    if digits == 0 or prev_us
        return -1
    loop
        let k = int_ws(s, i, b)
        if k == 0
            break
        i += k
    if i != b or (neg and v != 0)
        return -1
    return v

# escape sequence at lx.pos (a backslash); returns its UTF-8 bytes
lex_escape(lx)
    let src = lx.src
    let n = lx.n
    let p = lx.pos + 1
    if p >= n
        lx.pos = p + 1
        return "\0"
    let e = src[p]
    if e == 120
        if p + 2 >= n or hex_val(src[p + 1]) < 0 or hex_val(src[p + 2]) < 0
            lx.pos = p + 1
            lex_err(lx, "Invalid \\x escape: expected two hex digits")
        lx.pos = p + 3
        return utf8(hex_val(src[p + 1]) * 16 + hex_val(src[p + 2]))
    if e == 117 and p + 1 < n and src[p + 1] == 123
        var q = p + 2
        let st = q
        while q < n and src[q] != 125 and src[q] != 10 and src[q] != 0
            q += 1
        lx.pos = q
        if q >= n or src[q] != 125 or q == st
            lex_err(lx, "Invalid \\u{...} escape")
        let v = py_int16(src, st, q)
        if v < 0 or v > 1114111 or (v >= 55296 and v <= 57343)
            lex_err(lx, "Invalid \\u{...} escape")
        lx.pos = q + 1
        return utf8(v)
    lx.pos = p + 1
    if e == 110
        return "\n"
    if e == 116
        return "\t"
    if e == 114
        return "\r"
    if e == 48
        return "\0"
    if e == 97
        return "\a"
    if e == 98
        return "\b"
    if e == 101
        return "\e"
    if e < 128
        return src.slice(p, p + 1)
    # any other character stands for itself (whole UTF-8 sequence)
    var k = 1
    if e >= 240
        k = 4
    elif e >= 224
        k = 3
    elif e >= 192
        k = 2
    if p + k > n
        k = n - p
    lx.pos = p + k
    return src.slice(p, p + k)

is_spec_type(c)
    return c == 102 or c == 100 or c == 120 or c == 88 or c == 111 or c == 98 or c == 101 or c == 37

# length of the regex \d character at s[j] (a Unicode decimal digit), 0 if none
re_digit(s, j)
    let k = digit_at(s, j)
    if k == 1
        return 1
    if k == 2
        return ulen(s[j])
    return 0

# does s[i:] match the format-spec regex  [<>^]?\d*(\.\d+)?[fdxXobe%]?$
spec_ok(s, i)
    let n = len(s)
    var j = i
    if j < n and (s[j] == 60 or s[j] == 62 or s[j] == 94)
        j += 1
    while re_digit(s, j) > 0
        j += re_digit(s, j)
    if j + 1 < n and s[j] == 46 and re_digit(s, j + 1) > 0
        j += 1
        while re_digit(s, j) > 0
            j += re_digit(s, j)
    if j < n and is_spec_type(s[j])
        j += 1
    return j == n

# f-string expression part: [expression text, format spec or None]
fstr_part(text)
    let n = len(text)
    var i = 0
    while i < n
        if text[i] == 58 and spec_ok(text, i + 1)
            let g1 = text.slice(0, i)
            if len(strip_ws(g1)) > 0 and i + 1 < n
                return [g1, text.slice(i + 1, n)]
            return [text, None]
        i += 1
    return [text, None]

# f"..." -> FSTRING token whose value is a list of parts:
# a string (literal text) or [expression text, spec or None]
lex_fstring(lx, quote)
    let src = lx.src
    let n = lx.n
    var p = lx.pos + 1
    var parts = []
    var cur = []
    while p < n
        let c = src[p]
        if c == quote
            lx.pos = p + 1
            if len(cur) > 0
                parts.push(cur.join(""))
            add_tok(lx, T_FSTRING, parts)
            return
        if c == 123 and p + 1 < n and src[p + 1] == 123
            cur.push("{")
            p += 2
        elif c == 125 and p + 1 < n and src[p + 1] == 125
            cur.push("}")
            p += 2
        elif c == 123
            if len(cur) > 0
                parts.push(cur.join(""))
                cur = []
            p += 1
            let st = p
            var depth = 1
            var en = -1
            while p < n
                let d = src[p]
                if d == 10 or d == quote
                    lx.pos = p
                    lex_err(lx, "Unterminated '{' in f-string")
                if d == 123
                    depth += 1
                elif d == 125
                    depth -= 1
                    if depth == 0
                        en = p
                        p += 1
                        break
                p += 1
            if en < 0
                en = p
            parts.push(fstr_part(src.slice(st, en)))
        elif c == 92
            lx.pos = p
            cur.push(lex_escape(lx))
            p = lx.pos
        elif c == 10
            lx.pos = p
            lex_err(lx, "Unterminated f-string")
        else
            let st = p
            p += 1
            while p < n
                let d = src[p]
                if d == quote or d == 123 or d == 125 or d == 92 or d == 10
                    break
                p += 1
            cur.push(src.slice(st, p))
    lx.pos = p
    lex_err(lx, "Unterminated f-string")

digit_in_base(c, base)
    if c == 95
        return true
    let h = hex_val(c)
    return h >= 0 and h < base

# integer literal digits src[a:b] (underscores ignored) modulo 2^64; in base
# 10 also the other Unicode decimal digits (Python's int() accepts them)
parse_int_digits(src, a, b, base)
    var v = 0
    var big = None
    var exact = None
    var any = false
    var i = a
    while i < b
        let c = src[i]
        var step = 1
        if c != 95
            any = true
            var d = 0
            if c >= 128
                d = udigit(ucp(src, i))
                step = ulen(c)
            else
                d = hex_val(c)
            if big == None and v < 8388608
                v = v * base + d
            else
                if big == None
                    big = i64_of(v)
                    exact = bn_muladd([], 1, v)
                exact = bn_muladd(exact, base, d)
                var carry = d
                var k = 0
                while k < 4
                    let t = big[k] * base + carry
                    big[k] = t & 65535
                    carry = t >> 16
                    k += 1
        i += step
    if not any
        return None
    if big == None
        return v
    # Python keeps a literal of 2^63 or more exact in constant folding
    if bn_bitlen(exact) > 63
        return CV { ty: 0, v: i64_norm(big), x: exact }
    return i64_norm(big)

# value of the str.isdigit() character at s[p] (digit_at(s, p) > 0)
digit_value(s, p)
    let c = s[p]
    if c < 128
        return c - 48
    return udigit(ucp(s, p))

# end of a run of str.isdigit() characters (and underscores if us) from p;
# NUM_BAD is set when one of them is not a decimal digit (int() and float()
# reject those: superscripts, circled digits...), NUM_DIGITS counts them
var NUM_BAD = false
var NUM_DIGITS = 0
digit_run(src, p, us)
    let n = len(src)
    loop
        if p >= n
            return p
        let c = src[p]
        if c == 95 and us
            p += 1
        elif c >= 48 and c <= 57
            p += 1
            NUM_DIGITS += 1
        elif c < 128
            return p
        else
            let k = digit_at(src, p)
            if k == 0
                return p
            if k == 3
                NUM_BAD = true
            NUM_DIGITS += 1
            p += ulen(c)

lex_number(lx)
    let src = lx.src
    let n = lx.n
    let st = lx.pos
    var p = st
    if src[p] == 48 and p + 1 < n
        let x = src[p + 1]
        var base = 0
        var name = ""
        if x == 120 or x == 88
            base = 16
            name = "hexadecimal"
        elif x == 98 or x == 66
            base = 2
            name = "binary"
        elif x == 111 or x == 79
            base = 8
            name = "octal"
        if base > 0
            p += 2
            while p < n and digit_in_base(src[p], base)
                p += 1
            lx.pos = p
            let v = parse_int_digits(src, st + 2, p, base)
            if v == None
                lex_err(lx, "Invalid " + name + " literal: '" + src.slice(st, p) + "'")
            add_tok(lx, T_INT, v)
            return
    # Lexer.read_number: str.isdigit() characters, then int() / float()
    NUM_BAD = false
    NUM_DIGITS = 0
    p = digit_run(src, p, true)
    let int_end = p
    let int_digits = NUM_DIGITS
    var isf = false
    var fst = p
    var fen = p
    if p + 1 < n and src[p] == 46 and digit_at(src, p + 1) > 0
        isf = true
        p += 1
        fst = p
        p = digit_run(src, p, true)
        fen = p
    var ex = 0
    if p + 1 < n and (src[p] == 101 or src[p] == 69) and (digit_at(src, p + 1) > 0 or ((src[p + 1] == 43 or src[p + 1] == 45) and digit_at(src, p + 2) > 0))
        isf = true
        p += 1
        var neg = false
        if src[p] == 43 or src[p] == 45
            neg = src[p] == 45
            p += 1
        let es = p
        p = digit_run(src, p, false)
        if not NUM_BAD
            var i = es
            while i < p
                if ex < 100000
                    ex = ex * 10 + digit_value(src, i)
                i += ulen(src[i])
        if neg
            ex = 0 - ex
    lx.pos = p
    # int() also refuses more than 4300 decimal digits (sys.int_info.default_max_str_digits)
    if NUM_BAD or (not isf and int_digits > 4300)
        lex_err(lx, "Invalid numeric literal: '" + src.slice(st, p) + "'")
    if not isf
        add_tok(lx, T_INT, parse_int_digits(src, st, int_end, 10))
        return
    # D * 10^E
    var D = []
    var ndig = 0
    var i = st
    while i < fen
        let c = src[i]
        if c == 95 or c == 46
            i += 1
        else
            let d = digit_value(src, i)
            if ndig > 0 or d != 0
                D = bn_muladd(D, 10, d)
                ndig += 1
            if i >= fst
                ex -= 1
            i += ulen(c)
    add_tok(lx, T_FLOAT, float_bits_dec(D, ex, ndig))

lex_ident(lx)
    let src = lx.src
    let n = lx.n
    let st = lx.pos
    var p = st
    while p < n
        let c = src[p]
        if c < 128
            if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95
                p += 1
            else
                break
        elif uclass(ucp(src, p)) > 0
            p += ulen(c)
        else
            break
    lx.pos = p
    let text = src.slice(st, p)
    let b = src[st]
    let km = lx.sf.kwb.get_or(b, None)
    if km != None
        let kt = km.get_or(text, -1)
        if kt >= 0
            if kt == T_BOOL
                add_tok(lx, T_BOOL, TRUE_WORDS.has(text))
            else
                add_tok(lx, kt, text)
            return
    let am = lx.sf.alb.get_or(b, None)
    if am != None
        add_tok(lx, T_IDENT, am.get_or(text, text))
        return
    add_tok(lx, T_IDENT, text)

lex_op(lx, c)
    let src = lx.src
    let p = lx.pos
    var d = 0
    if p + 1 < lx.n
        d = src[p + 1]
    if c == 46 and d == 46 and p + 2 < lx.n and src[p + 2] == 61
        lx.pos = p + 3
        add_tok(lx, T_RANGE_INCL, "..=")
        return true
    var t = -1
    var v = ""
    if d == 61
        if c == 61
            t = T_EQEQ
            v = "=="
        elif c == 33
            t = T_NEQ
            v = "!="
        elif c == 60
            t = T_LTE
            v = "<="
        elif c == 62
            t = T_GTE
            v = ">="
        elif c == 43
            t = T_PLUSEQ
            v = "+="
        elif c == 45
            t = T_MINUSEQ
            v = "-="
        elif c == 42
            t = T_STAREQ
            v = "*="
        elif c == 47
            t = T_SLASHEQ
            v = "/="
        elif c == 37
            t = T_PERCENTEQ
            v = "%="
    elif d == 62
        if c == 45
            t = T_ARROW
            v = "->"
        elif c == 61
            t = T_FAT_ARROW
            v = "=>"
        elif c == 62
            t = T_SHR
            v = ">>"
        elif c == 124
            t = T_PIPE_GT
            v = "|>"
    elif c == 46 and d == 46
        t = T_RANGE
        v = ".."
    elif c == 60 and d == 60
        t = T_SHL
        v = "<<"
    elif c == 42 and d == 42
        t = T_POWER
        v = "**"
    if t >= 0
        lx.pos = p + 2
        add_tok(lx, t, v)
        return true
    let t1 = ONE_CHAR.get_or(c, -1)
    if t1 < 0
        return false
    if c == 40 or c == 91 or c == 123
        lx.paren += 1
    elif c == 41 or c == 93 or c == 125
        if lx.paren > 0
            lx.paren -= 1
    lx.pos = p + 1
    add_tok(lx, t1, src.slice(p, p + 1))
    return true

# ═══════════════════════════════════════════════════════════════════════════
#                                   AST
# ═══════════════════════════════════════════════════════════════════════════

# one node type for everything: k = kind, ln = source line (as set by the
# Python parser's _mark), s/a/b/c/n = kind-specific fields (see below)
struct N
    k: int
    ln: int
    s: any
    a: any
    b: any
    c: any
    n: any

const K_INT = 1
const K_FLOAT = 2
const K_STR = 3
const K_CHAR = 4
const K_BOOL = 5
const K_FSTR = 6
const K_FPART = 7
const K_IDENT = 8
const K_BIN = 9
const K_UN = 10
const K_CALL = 11
const K_INDEX = 12
const K_ATTR = 13
const K_ARRAY = 14
const K_TUPLE = 15
const K_DICT = 16
const K_RANGE = 17
const K_SINIT = 18
const K_IFX = 19
const K_CAST = 20
const K_NULLCHK = 21
const K_LAMBDA = 22
const K_MATCH = 23
const K_LISTCOMP = 24
const K_RETRY = 25
const K_TIMEOUT = 26
const K_FORK = 27
const K_VAR = 31
const K_STMT = 32
const K_GINIT = 42
const K_FUNC = 50
const K_STRUCTDEF = 51
const K_ENUMDEF = 52
const K_IMPL = 53
const K_TYPEALIAS = 54
const K_TRAIT = 55
const K_IMPORT = 56

# K_INT n=value | K_FLOAT s=8 bytes | K_STR s | K_CHAR n=code point | K_BOOL n
# K_FSTR c=[K_STR | K_FPART(a=expr, s=spec)] | K_IDENT s | K_BIN s=op a b
# K_UN s=op a | K_CALL a=callee c=args | K_INDEX a b | K_ATTR a s
# K_ARRAY/K_TUPLE c | K_DICT c=[k, v, ...] | K_RANGE a b n=inclusive
# K_SINIT s=name c={field: expr} | K_IFX a b c | K_CAST a s=type | K_NULLCHK a
# K_LAMBDA a=body c=[param names] | K_MATCH a=value c=[[pattern, guard, expr]]
# K_LISTCOMP a=expr s=var b=iter c=condition
# K_RETRY / K_TIMEOUT a=count|ms b=body c=fallback (expression or K_FORK)
# K_FORK a=a token stream positioned at a block (compiled later as a value)
# Statements have no tree: they are compiled while they are parsed (stmt_c).
# Top-level items: K_FUNC a=FI | K_STRUCTDEF s c=[Fld] | K_ENUMDEF s c=[Vnt]
# K_IMPL s=type b=trait c=[FI] | K_TRAIT s c=[FI] | K_TYPEALIAS s=name
# K_IMPORT s=module b=alias c=[names] or None (all) | K_VAR (global) s b=type n=flags (1 mutable,
# 2 const, 4 deferred) a=literal value or None c=[pos, line] of the value
# K_STMT c=[pos, line] (script statement) | K_GINIT a=K_VAR (deferred init)

mk(k, ln)
    return N { k: k, ln: ln }

# a function definition (FuncDef) without its body: the body is re-read from
# the source (src, bpos, bline, indentation stack) when it is compiled
struct FI
    name: str
    params: any
    ret: any
    ln: int
    src: any
    bpos: int
    bline: int
    bind: int
    body: any
    pre: any
    prelude: bool
    synth: bool
    capt: any
    req: any
    ens: any
    nstmts: int
    decl: any
    pure: bool
    caps: any
    sc: any

struct Prm
    name: str
    ty: any
    def: any

struct Fld
    name: str
    ty: any
    def: any

struct Vnt
    name: str
    value: any
    nf: int

# ═══════════════════════════════════════════════════════════════════════════
#                                  PARSER
# ═══════════════════════════════════════════════════════════════════════════

struct TS
    lx: any
    buf: any
    p: int

var TSG = None
var TK = None
var PENDING_ATTRS = []
var ITEMS = []
var MAIN_SF = None
# first pass: statements are only parsed (no code is generated)
var DRY = false
# first pass: names used inside lambdas of the function being parsed (they
# must live in cells - BytecodeCompiler.captured_names), and the immutable
# globals that are compile-time constants (SemanticChecker.consts)
var CAPT = None
var SCRIPT_CAPT = {}
var SINIT_DEPTH = 0
var SEM_CONSTS = {}
# kind of the statement stmt_c just read: 1 expression, 2 match, 3 if with
# else, 4 intent, 0 other (what compile_block_value needs of a last statement)
var LAST_STMT = 0
# SemanticChecker (effects, capabilities): while the first pass parses a
# function body it records the calls and the names it uses (SCI). Only done
# when the main file has #[pure] / #[effects] / #[cap] attributes or imports
# (decided by parse_program on the tokens).
var SC_ON = false
var SC_CUR = None
var SC_SCRIPT = None
var IO_BUILTINS = {"print": 1, "println": 1, "input": 1, "read_file": 1, "write_file": 1,
    "file_exists": 1, "screen_init": 1, "screen_clear": 1, "draw_pixel": 1, "draw_line": 1,
    "draw_rect": 1, "fill_rect": 1, "draw_circle": 1, "draw_text": 1, "get_pixel": 1,
    "screen_show": 1, "key_pressed": 1, "wait_key": 1, "energy_mode": 1}

struct SCI
    io: int
    calls: any
    refs: any

new_stream(lx)
    TSG = TS { lx: lx, buf: [], p: 0 }
    TK = peek(0)

peek(k)
    let ts = TSG
    let i = ts.p + k
    let buf = ts.buf
    while len(buf) <= i
        if ts.lx == None
            return buf[len(buf) - 1]
        buf.push(lex_next(ts.lx))
    return buf[i]

adv()
    let t = TK
    let ts = TSG
    ts.p += 1
    if ts.p >= len(ts.buf)
        ts.buf.clear()
        ts.p = 0
    elif ts.p >= 64
        # a lookahead (is_func_def peeks at the next line) can keep the
        # buffer from ever emptying: drop the tokens already consumed
        ts.buf = ts.buf.slice(ts.p, len(ts.buf))
        ts.p = 0
    TK = peek(0)
    return t

perr(msg)
    fail_at(TK.ln, msg)

expect(t)
    if TK.t == t
        return adv()
    perr("Expected " + TT_NAMES[t] + ", got " + TT_NAMES[TK.t])

skip_nl()
    while TK.t == T_NEWLINE
        adv()

# ── top level ───────────────────────────────────────────────────────────────
parse_program(sf)
    # Lexer.tokenize runs over the whole file before parsing: lexical errors
    # are reported before syntax errors (tokens are not kept). The same pass
    # decides whether the SemanticChecker's call graph is needed: only when
    # a function can declare effects or capabilities (#[pure], #[effects: ..],
    # #[cap: ..]) or a module (which may declare them) is imported. This is
    # decided on the tokens, so every spelling counts (localized keywords,
    # tabs, several attributes on a line, spaces inside #[ ]).
    let lx = new_lexer(sf, 0, 1, [0], true)
    loop
        let tok = lex_next(lx)
        let t = tok.t
        if t == T_EOF
            break
        if t == T_IMPORT or t == T_FROM or (t == T_ATTRIBUTE and sc_attribute(tok.v))
            SC_ON = true
    if SC_ON
        SC_SCRIPT = SCI { calls: {}, refs: {} }
    DRY = true
    new_stream(new_lexer(sf, 0, 1, [0], true))
    skip_nl()
    while TK.t != T_EOF
        parse_top_level(sf)
        skip_nl()
    DRY = false

parse_top_level(src)
    let tok = TK
    skip_nl()
    var attrs = false
    while TK.t == T_ATTRIBUTE
        PENDING_ATTRS.push(adv().v)
        skip_nl()
        attrs = true
    let t = TK.t
    var node = None
    if t == T_IMPORT or t == T_FROM
        node = parse_import()
    elif t == T_PUB
        adv()
        node = parse_pub_item(src)
    elif t == T_STRUCT
        node = parse_struct()
    elif t == T_ENUM
        node = parse_enum()
    elif t == T_IMPL
        node = parse_impl(src)
    elif t == T_TRAIT
        node = parse_trait(src)
    elif t == T_FN
        node = parse_fn(src, 0)
    elif t == T_TYPE
        expect(T_TYPE)
        node = mk(K_TYPEALIAS, 0)
        node.s = expect(T_IDENT).v
        expect(T_EQ)
        parse_type()
    elif t == T_CONST or t == T_LET or t == T_VAR
        node = parse_global(tok)
    elif t == T_CAP
        adv()
        let cap_name = expect(T_IDENT).v
        if TK.t == T_LBRACE
            adv()
            while TK.t != T_RBRACE
                expect(T_IDENT)
                if TK.t == T_COMMA
                    adv()
            expect(T_RBRACE)
        node = mk(K_TYPEALIAS, 0)
        node.s = cap_name
    elif t == T_IDENT and is_func_def()
        node = parse_func_simple(src, 0)
    else
        # a script statement: remember where it starts, compile it in main().
        # Consecutive statements share one item (c[3] = how many): main()
        # re-reads them in one go, so a long script needs little memory.
        var prev = None
        if len(ITEMS) > 0 and not attrs
            prev = ITEMS[len(ITEMS) - 1]
        if prev != None and prev.k == K_STMT and prev.c[2] == src
            prev.c[3] = prev.c[3] + 1
        else
            node = mk(K_STMT, TK.ln)
            node.c = [TK.sp, TK.ln, src, 1]
        CAPT = SCRIPT_CAPT
        SC_CUR = SC_SCRIPT
        stmt_c()
        CAPT = None
        SC_CUR = None
        if node == None
            return
    if node.ln == 0
        node.ln = tok.ln
    ITEMS.push(node)

# top-level let / var / const: a global. Only a literal value is kept as a
# tree; other initializers are re-read from their position when compiled.
parse_global(tok)
    let t = TK.t
    let kw = adv()
    let node = mk(K_VAR, kw.ln)
    if t == T_CONST
        node.ln = tok.ln
        node.n = 2
    elif t == T_VAR
        node.n = 1
    else
        node.n = 0
    node.s = expect(T_IDENT).v
    if TK.t == T_COLON
        adv()
        node.b = parse_type()
    if t == T_CONST
        expect(T_EQ)
    elif TK.t == T_EQ
        adv()
    else
        return node
    let capt = {}
    CAPT = capt
    var sci = None
    if SC_ON
        sci = SCI { calls: {}, refs: {} }
    SC_CUR = sci
    node.c = [TK.sp, TK.ln, None, sci, TSG.lx.sf]
    let v = parse_expression()
    CAPT = None
    SC_CUR = None
    if len(capt) > 0
        node.c[2] = capt
    if is_literal(v)
        node.a = v
    if node.n != 1
        let c = const_eval(v, SEM_CONSTS)
        if c != None
            SEM_CONSTS[node.s] = c
    return node

# import a.b [as x]   |   from a.b import x, y   |   from a.b import *
parse_import()
    let node = mk(K_IMPORT, 0)
    let from_form = TK.t == T_FROM
    adv()
    var name = expect(T_IDENT).v
    while TK.t == T_DOT
        adv()
        name = name + "." + expect(T_IDENT).v
    node.s = name
    if from_form
        expect(T_IMPORT)
        if TK.t == T_STAR
            adv()
        else
            var items = []
            loop
                items.push(expect(T_IDENT).v)
                if TK.t != T_COMMA
                    break
                adv()
            node.c = items
    elif TK.t == T_AS
        adv()
        node.b = expect(T_IDENT).v
    return node

parse_pub_item(src)
    if TK.t == T_STRUCT
        return parse_struct()
    if TK.t == T_ENUM
        return parse_enum()
    if TK.t == T_FN
        return parse_fn(src, 0)
    if TK.t == T_TRAIT
        return parse_trait(src)
    if TK.t == T_IDENT and is_func_def()
        return parse_func_simple(src, 0)
    perr("Expected struct, enum, fn, or trait after 'pub'")

# name(...) followed by -> / { / => / NEWLINE INDENT is a definition
is_func_def()
    if TK.t != T_IDENT or peek(1).t != T_LPAREN
        return false
    var k = 2
    var depth = 1
    while depth > 0 and peek(k).t != T_EOF
        let t = peek(k).t
        if t == T_LPAREN
            depth += 1
        elif t == T_RPAREN
            depth -= 1
        k += 1
    let t = peek(k).t
    if t == T_ARROW or t == T_LBRACE or t == T_FAT_ARROW
        return true
    if t == T_NEWLINE
        while peek(k).t == T_NEWLINE
            k += 1
        return peek(k).t == T_INDENT
    return false

parse_fn(src, ind)
    expect(T_FN)
    return parse_func_body(expect(T_IDENT), src, ind, false)

parse_func_simple(src, ind)
    return parse_func_body(expect(T_IDENT), src, ind, false)

parse_func_body(name_tok, src, ind, allow_sig)
    expect(T_LPAREN)
    let params = parse_params()
    expect(T_RPAREN)
    var ret = "void"
    if TK.t == T_ARROW
        adv()
        ret = parse_type()
    let bpos = TK.sp
    let bline = TK.ln
    let save_capt = CAPT
    CAPT = {}
    let save_sc = SC_CUR
    if SC_ON
        SC_CUR = SCI { calls: {}, refs: {} }
    let nstmts = func_body_c(allow_sig)
    let attrs = PENDING_ATTRS
    PENDING_ATTRS = []
    let sci = SC_CUR
    SC_CUR = save_sc
    var req = []
    var ens = []
    var decl = None
    var pure = false
    var caps = []
    for a in attrs
        if a == "pure"
            pure = true
            if decl == None or len(decl) == 0
                decl = []
        elif a.starts_with("effects:")
            if decl == None or len(decl) == 0
                decl = []
            for e in strip_ws(a.slice(8, len(a))).split(",")
                if len(strip_ws(e)) > 0
                    decl.push(strip_ws(e))
        elif a.starts_with("requires:") or a.starts_with("ensures:")
            let colon = a.find(":")
            let text = strip_ws(a.slice(colon + 1, len(a)))
            let e = parse_sub_expr(text, name_tok.ln, false)
            if a.starts_with("requires:")
                req.push([e, text])
            else
                ens.push([e, text])
        elif a.starts_with("cap:")
            for c in a.slice(4, len(a)).split(",")
                if len(strip_ws(c)) > 0
                    caps.push(strip_ws(c))
    # (empty lists and maps are left out: they would cost memory per function)
    let fi = FI { name: name_tok.v, params: params, ret: ret, ln: name_tok.ln, src: src,
                  bpos: bpos, bline: bline, bind: ind, nstmts: nstmts, decl: decl, pure: pure,
                  sc: sci }
    if len(CAPT) > 0
        fi.capt = CAPT
    if len(req) > 0
        fi.req = req
    if len(ens) > 0
        fi.ens = ens
    if len(caps) > 0
        fi.caps = caps
    CAPT = save_capt
    let node = mk(K_FUNC, name_tok.ln)
    node.a = fi
    return node

parse_params()
    var params = []
    if TK.t == T_RPAREN
        return params
    loop
        if TK.t == T_MUT
            adv()
        if TK.t == T_SELF
            adv()
            params.push(Prm { name: "self", ty: "" })
        else
            let name = expect(T_IDENT).v
            var ty = ""
            if TK.t == T_COLON
                adv()
                ty = parse_type()
            var def = None
            if TK.t == T_EQ
                adv()
                def = parse_expression()
            params.push(Prm { name: name, ty: ty, def: def })
        if TK.t != T_COMMA
            break
        adv()
    return params

# a type -> tag: primitive name, "void", "Option", "Result" or "" (other)
parse_type()
    if TK.t == T_STAR
        adv()
        if TK.t == T_MUT
            adv()
        parse_type()
        return ""
    if TK.t == T_LBRACKET
        adv()
        parse_type()
        if TK.t == T_SEMICOLON
            adv()
            expect(T_INT)
        expect(T_RBRACKET)
        return ""
    if TK.t == T_FN
        adv()
        expect(T_LPAREN)
        if TK.t != T_RPAREN
            loop
                parse_type()
                if TK.t != T_COMMA
                    break
                adv()
        expect(T_RPAREN)
        if TK.t == T_ARROW
            adv()
            parse_type()
        return ""
    let name = expect(T_IDENT).v
    if TK.t == T_LT
        adv()
        loop
            parse_type()
            if TK.t != T_COMMA
                break
            adv()
        expect(T_GT)
        if name == "Option" or name == "Result"
            return name
        return ""
    var base = ""
    if PRIM.has(name)
        base = name
    if TK.t == T_LBRACKET
        adv()
        if TK.t == T_INT
            adv()
        expect(T_RBRACKET)
        return ""
    return base

parse_struct()
    expect(T_STRUCT)
    let name = expect(T_IDENT).v
    skip_nl()
    expect(T_INDENT)
    var fields = []
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        if TK.t == T_PUB
            adv()
        let fname = expect(T_IDENT).v
        expect(T_COLON)
        let fty = parse_type()
        var def = None
        if TK.t == T_EQ
            adv()
            def = parse_expression()
        fields.push(Fld { name: fname, ty: fty, def: def })
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    let node = mk(K_STRUCTDEF, 0)
    node.s = name
    node.c = fields
    return node

parse_enum()
    expect(T_ENUM)
    let name = expect(T_IDENT).v
    skip_nl()
    expect(T_INDENT)
    var variants = []
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        let vname = expect(T_IDENT).v
        var value = None
        if TK.t == T_EQ
            adv()
            value = parse_expression()
        var nf = 0
        if TK.t == T_LPAREN
            adv()
            if TK.t != T_RPAREN
                loop
                    parse_type()
                    nf += 1
                    if TK.t != T_COMMA
                        break
                    adv()
            expect(T_RPAREN)
        variants.push(Vnt { name: vname, value: value, nf: nf })
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    let node = mk(K_ENUMDEF, 0)
    node.s = name
    node.c = variants
    return node

parse_impl(src)
    expect(T_IMPL)
    var first = expect(T_IDENT).v
    var trait_name = None
    if TK.t == T_FOR
        adv()
        trait_name = first
        first = expect(T_IDENT).v
    skip_nl()
    let ind = TK
    expect(T_INDENT)
    var methods = []
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        while TK.t == T_ATTRIBUTE
            PENDING_ATTRS.push(adv().v)
            skip_nl()
        var m = None
        if TK.t == T_FN
            m = parse_fn(src, ind.v)
        elif TK.t == T_IDENT and is_func_def()
            m = parse_func_simple(src, ind.v)
        else
            perr("Expected method definition in impl block")
        methods.push(m.a)
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    let node = mk(K_IMPL, 0)
    node.s = first
    node.c = methods
    node.b = trait_name
    return node

parse_trait(src)
    expect(T_TRAIT)
    let name = expect(T_IDENT).v
    skip_nl()
    let ind = TK
    expect(T_INDENT)
    var methods = []
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        if TK.t == T_FN
            adv()
        if TK.t == T_IDENT and peek(1).t == T_LPAREN
            methods.push(parse_func_body(adv(), src, ind.v, true).a)
        else
            perr("Expected method definition in trait")
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    let node = mk(K_TRAIT, 0)
    node.s = name
    node.c = methods
    return node

# ── expressions (precedence climbing, as Parser.parse_expression) ──────────
parse_expression()
    let expr = parse_pipe()
    if TK.t == T_IF
        let if_tok = adv()
        let node = mk(K_IFX, if_tok.ln)
        node.a = parse_pipe()
        expect(T_ELSE)
        node.b = expr
        node.c = parse_expression()
        return node
    return expr

parse_pipe()
    var left = parse_or()
    while TK.t == T_PIPE_GT
        let op = adv()
        let right = parse_or()
        if right.k == K_CALL
            right.c.insert(0, left)
            left = right
        else
            let call = mk(K_CALL, op.ln)
            call.a = right
            call.c = [left]
            left = call
            if SC_CUR != None and SINIT_DEPTH == 0
                sc_call(right, op.ln)
    return left

# a call seen by the SemanticChecker walk: callee (unresolved) and io effect
sc_call(f, ln)
    let s = SC_CUR
    var key = ""
    var rec = None
    if f.k == K_IDENT
        if s.io == 0 and IO_BUILTINS.has(f.s)
            s.io = ln
        key = "1" + f.s
        rec = [1, f.s, None, ln]
    elif f.k == K_ATTR
        if f.a.k == K_IDENT
            key = "2" + f.a.s + "." + f.s
            rec = [2, f.a.s, f.s, ln]
        else
            key = "3" + f.s
            rec = [3, None, f.s, ln]
    else
        return
    if not s.calls.has(key)
        s.calls[key] = rec

binop(op, ln, a, b)
    let node = mk(K_BIN, ln)
    node.s = op
    node.a = a
    node.b = b
    return node

parse_or()
    var left = parse_and()
    while TK.t == T_OR
        let op = adv()
        left = binop("or", op.ln, left, parse_and())
    return left

parse_and()
    var left = parse_not()
    while TK.t == T_AND
        let op = adv()
        left = binop("and", op.ln, left, parse_not())
    return left

# prefix operators are collected in a loop (a long `not not ...` or `- - x`
# chain must not need a deep call stack), then applied inside out
wrap_prefix(ops, e)
    var i = len(ops) - 1
    while i >= 0
        ops[i].a = e
        e = ops[i]
        i -= 1
    return e

parse_not()
    if TK.t != T_NOT
        return parse_comparison()
    var ops = []
    while TK.t == T_NOT
        let node = mk(K_UN, adv().ln)
        node.s = "not"
        ops.push(node)
    return wrap_prefix(ops, parse_comparison())

parse_comparison()
    var left = parse_bitor()
    var result = None
    loop
        let t = TK.t
        if t != T_EQEQ and t != T_NEQ and t != T_LT and t != T_GT and t != T_LTE and t != T_GTE
            break
        let op = adv()
        let right = parse_bitor()
        let cmp = binop(op.v, op.ln, left, right)
        if result == None
            result = cmp
        else
            result = binop("and", op.ln, result, cmp)
        left = right
    if result == None
        return left
    return result

parse_bitor()
    var left = parse_bitxor()
    while TK.t == T_PIPE
        let op = adv()
        left = binop(op.v, op.ln, left, parse_bitxor())
    return left

parse_bitxor()
    var left = parse_bitand()
    while TK.t == T_CARET
        let op = adv()
        left = binop(op.v, op.ln, left, parse_bitand())
    return left

parse_bitand()
    var left = parse_shift()
    while TK.t == T_AMP
        let op = adv()
        left = binop(op.v, op.ln, left, parse_shift())
    return left

parse_shift()
    var left = parse_range()
    while TK.t == T_SHL or TK.t == T_SHR
        let op = adv()
        left = binop(op.v, op.ln, left, parse_range())
    return left

parse_range()
    let left = parse_additive()
    if TK.t == T_RANGE or TK.t == T_RANGE_INCL
        let op = adv()
        let node = mk(K_RANGE, op.ln)
        node.a = left
        node.b = parse_additive()
        node.n = op.t == T_RANGE_INCL
        return node
    return left

parse_additive()
    var left = parse_multiplicative()
    while TK.t == T_PLUS or TK.t == T_MINUS
        let op = adv()
        left = binop(op.v, op.ln, left, parse_multiplicative())
    return left

parse_multiplicative()
    var left = parse_unary()
    while TK.t == T_STAR or TK.t == T_SLASH or TK.t == T_PERCENT
        let op = adv()
        left = binop(op.v, op.ln, left, parse_unary())
    return left

parse_unary()
    var ops = None
    loop
        let t = TK.t
        if t != T_MINUS and t != T_TILDE and t != T_AMP and t != T_STAR
            break
        let tok = adv()
        let node = mk(K_UN, tok.ln)
        if t == T_MINUS
            node.s = "-"
        elif t == T_TILDE
            node.s = "~"
        elif t == T_STAR
            node.s = "*"
        else
            node.s = "&"
            if TK.t == T_MUT
                adv()
                node.s = "&mut"
        if ops == None
            ops = []
        ops.push(node)
    if ops == None
        return parse_power()
    return wrap_prefix(ops, parse_power())

parse_power()
    let left = parse_postfix()
    if TK.t == T_POWER
        let op = adv()
        return binop("**", op.ln, left, parse_unary())
    return left

parse_postfix()
    var expr = parse_primary()
    if SC_CUR != None and SINIT_DEPTH == 0 and expr.k == K_IDENT and TK.t != T_LPAREN
        if not SC_CUR.refs.has(expr.s)
            SC_CUR.refs[expr.s] = expr.ln
    loop
        let t = TK.t
        if t == T_LPAREN
            let op = adv()
            if SC_CUR != None and SINIT_DEPTH == 0
                sc_call(expr, op.ln)
            var args = []
            if TK.t != T_RPAREN
                loop
                    args.push(parse_expression())
                    if TK.t != T_COMMA
                        break
                    adv()
            expect(T_RPAREN)
            let node = mk(K_CALL, op.ln)
            node.a = expr
            node.c = args
            expr = node
        elif t == T_LBRACKET
            let op = adv()
            let node = mk(K_INDEX, op.ln)
            node.a = expr
            node.b = parse_expression()
            expect(T_RBRACKET)
            expr = node
        elif t == T_DOT
            let op = adv()
            let node = mk(K_ATTR, op.ln)
            node.a = expr
            node.s = expect(T_IDENT).v
            expr = node
        elif t == T_AS
            let op = adv()
            let node = mk(K_CAST, op.ln)
            node.a = expr
            node.s = parse_type()
            expr = node
        elif t == T_QUESTION
            let op = adv()
            let node = mk(K_NULLCHK, op.ln)
            node.a = expr
            expr = node
        else
            break
    return expr

parse_primary()
    let tok = TK
    let node = parse_primary_inner()
    if node.ln == 0
        node.ln = tok.ln
    return node

parse_primary_inner()
    let t = TK.t
    if t == T_IDENT
        let tok = adv()
        let name = tok.v
        if name == "None"
            let node = mk(K_IDENT, 0)
            node.s = "NULL"
            return node
        if (name == "Vec" or name == "HashMap") and TK.t == T_LT
            adv()
            var targs = []
            loop
                targs.push(expect(T_IDENT).v)
                if TK.t != T_COMMA
                    break
                adv()
            expect(T_GT)
            let node = mk(K_IDENT, 0)
            node.s = "__" + name + "__" + targs.join("_")
            return node
        if TK.t == T_LBRACE
            adv()
            var fields = {}
            if TK.t != T_RBRACE
                SINIT_DEPTH += 1
                loop
                    let fname = expect(T_IDENT).v
                    expect(T_COLON)
                    fields[fname] = parse_expression()
                    if TK.t != T_COMMA
                        break
                    adv()
                SINIT_DEPTH -= 1
            expect(T_RBRACE)
            let node = mk(K_SINIT, 0)
            node.s = name
            node.c = fields
            return node
        let node = mk(K_IDENT, 0)
        node.s = name
        return node
    if t == T_INT
        let node = mk(K_INT, 0)
        let v = adv().v
        if type_of(v) == "CV"
            # 2^63 or more: s = the exact value (natural number limbs)
            node.n = v.v
            node.s = v.x
        else
            node.n = v
        return node
    if t == T_STRING
        let node = mk(K_STR, 0)
        node.s = adv().v
        return node
    if t == T_FSTRING
        let tok = adv()
        var parts = []
        for part in tok.v
            if type_of(part) == "str"
                let sn = mk(K_STR, tok.ln)
                sn.s = part
                parts.push(sn)
            else
                let fp = mk(K_FPART, 0)
                fp.a = parse_fexpr(part[0], tok.ln)
                fp.s = part[1]
                parts.push(fp)
        let node = mk(K_FSTR, 0)
        node.c = parts
        return node
    if t == T_FLOAT
        let node = mk(K_FLOAT, 0)
        node.s = adv().v
        return node
    if t == T_CHAR
        let node = mk(K_CHAR, 0)
        node.n = adv().v
        return node
    if t == T_BOOL
        let node = mk(K_BOOL, 0)
        node.n = adv().v
        return node
    if t == T_LPAREN
        adv()
        if TK.t == T_RPAREN
            adv()
            let node = mk(K_ARRAY, 0)
            node.c = []
            return node
        let expr = parse_expression()
        if TK.t == T_COMMA
            var elems = [expr]
            while TK.t == T_COMMA
                adv()
                if TK.t == T_RPAREN
                    break
                elems.push(parse_expression())
            expect(T_RPAREN)
            let node = mk(K_TUPLE, 0)
            node.c = elems
            return node
        expect(T_RPAREN)
        return expr
    if t == T_LBRACKET
        adv()
        var elems = []
        if TK.t != T_RBRACKET
            elems.push(parse_expression())
            if TK.t == T_FOR
                adv()
                let lc = mk(K_LISTCOMP, 0)
                lc.a = elems[0]
                lc.s = expect(T_IDENT).v
                expect(T_IN)
                lc.b = parse_or()
                if TK.t == T_IF
                    adv()
                    lc.c = parse_or()
                expect(T_RBRACKET)
                return lc
            while TK.t == T_COMMA
                adv()
                if TK.t == T_RBRACKET
                    break
                elems.push(parse_expression())
        expect(T_RBRACKET)
        let node = mk(K_ARRAY, 0)
        node.c = elems
        return node
    if t == T_LBRACE
        adv()
        var pairs = []
        if TK.t != T_RBRACE
            loop
                pairs.push(parse_expression())
                expect(T_COLON)
                pairs.push(parse_expression())
                if TK.t != T_COMMA
                    break
                adv()
        expect(T_RBRACE)
        let node = mk(K_DICT, 0)
        node.c = pairs
        return node
    if t == T_SELF
        adv()
        let node = mk(K_IDENT, 0)
        node.s = "self"
        return node
    if t == T_PIPE
        return parse_lambda()
    if t == T_MATCH
        return parse_match()
    if t == T_RETRY or t == T_TIMEOUT
        adv()
        var node = mk(K_RETRY, 0)
        if t == T_TIMEOUT
            node = mk(K_TIMEOUT, 0)
        expect(T_LPAREN)
        node.a = parse_expression()
        expect(T_RPAREN)
        skip_nl()
        node.b = body_or_expr()
        skip_nl()
        if TK.t == T_ELSE
            adv()
            skip_nl()
            node.c = body_or_expr()
        return node
    if t == T_HANDLE
        unsupported(TK.ln, "handle (effects)")
    perr("Unexpected token: " + TT_NAMES[t])

body_or_expr()
    if TK.t == T_INDENT
        return block_ref()
    return parse_expression()

# |x, y| expr   or   |x: int| -> int { expr }
parse_lambda()
    adv()
    var params = []
    if TK.t != T_PIPE
        loop
            params.push(expect(T_IDENT).v)
            if TK.t == T_COLON
                adv()
                parse_type()
            if TK.t != T_COMMA
                break
            adv()
    expect(T_PIPE)
    if TK.t == T_ARROW
        adv()
        parse_type()
    let node = mk(K_LAMBDA, 0)
    node.c = params
    if TK.t == T_LBRACE
        adv()
        skip_nl()
        node.a = parse_expression()
        skip_nl()
        expect(T_RBRACE)
    else
        node.a = parse_expression()
    # BytecodeCompiler.captured_names: walk() reaches this lambda unless it
    # sits in a struct literal (whose fields are a dict, not walked)
    if CAPT != None and SINIT_DEPTH == 0
        lambda_names(node, CAPT)
    return node

# names used in a lambda's body that are not its parameters
lambda_names(lam, out)
    var pm = {}
    for p in lam.c
        pm[p] = 1
    walk_idents(lam.a, pm, out)

# the nodes of a tree in walk() order (pre-order: a, b, c, arrays in order;
# struct literals are opaque), with an explicit stack (no deep recursion)
tree_nodes(x)
    var out = []
    var stack = [x]
    while len(stack) > 0
        let y = stack.pop()
        let t = type_of(y)
        if t == "array"
            var i = len(y) - 1
            while i >= 0
                stack.push(y[i])
                i -= 1
        elif t == "N"
            out.push(y)
            if y.k != K_SINIT and y.k != K_IDENT
                stack.push(y.c)
                stack.push(y.b)
                stack.push(y.a)
    return out

# every identifier of a tree (as walk() visits them)
walk_idents(x, params, out)
    for y in tree_nodes(x)
        if y.k == K_IDENT and not params.has(y.s)
            out[y.s] = 1

# captured_names(tree): names used by the lambdas inside a tree
lambda_captures(x, out)
    for y in tree_nodes(x)
        if y.k == K_LAMBDA
            lambda_names(y, out)

parse_match()
    adv()
    let node = mk(K_MATCH, 0)
    node.a = parse_expression()
    skip_nl()
    expect(T_INDENT)
    var arms = []
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        let pat = parse_or()
        var guard = None
        if TK.t == T_IF
            adv()
            guard = parse_or()
        expect(T_FAT_ARROW)
        arms.push([pat, guard, parse_expression()])
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    node.c = arms
    return node

# expression inside an f-string: lexed and parsed on its own, at the line of
# the f-string (as Parser._parse_fstring_expr)
parse_fexpr(text, line)
    return parse_sub_expr(text, line, true)

# an expression from another text (f-string part, #[requires: ...]) whose
# tokens all carry `line`
parse_sub_expr(text, line, walked)
    let save_sc = SC_CUR
    if not walked
        SC_CUR = None
    let save_ts = TSG
    let save_tk = TK
    var l = line
    if l < 1
        l = 1
    let cur = TSG.lx.sf
    new_stream(new_lexer(SrcFile { text: text, kwb: cur.kwb, alb: cur.alb, name: cur.name }, 0, l, [0], true))
    let e = parse_expression()
    while TK.t != T_EOF
        adv()
    TSG = save_ts
    TK = save_tk
    SC_CUR = save_sc
    return e

# ── script mode (Parser.hoist_script_statements) ───────────────────────────
is_definition(it)
    return it.k != K_STMT

is_literal(node)
    if node == None
        return false
    let k = node.k
    return k == K_INT or k == K_FLOAT or k == K_STR or k == K_BOOL or k == K_CHAR

hoist()
    var any_stmt = false
    for it in ITEMS
        if not is_definition(it)
            any_stmt = true
    if not any_stmt
        return
    var script = []
    var rest = []
    var seen = false
    for it in ITEMS
        if not is_definition(it)
            seen = true
            script.push(it)
        elif it.k == K_VAR and seen and it.c != None and it.a == None
            it.n = it.n | 4
            rest.push(it)
            let g = mk(K_GINIT, it.ln)
            g.a = it
            script.push(g)
        else
            rest.push(it)
    var main = None
    for it in rest
        if main == None and it.k == K_FUNC and it.a.name == "main"
            main = it.a
    if main == None
        main = FI { name: "main", params: [], ret: "void", ln: script[0].ln, pre: script,
                    synth: true, capt: {}, req: [], ens: [] }
        let node = mk(K_FUNC, main.ln)
        node.a = main
        rest.push(node)
    else
        main.pre = script
    if main.capt == None
        main.capt = {}
    for k in SCRIPT_CAPT
        main.capt[k] = 1
    for it in script
        if it.k == K_GINIT and it.a.c[2] != None
            for k in it.a.c[2]
                main.capt[k] = 1
    if SC_ON
        var merged = SCI { calls: {}, refs: {} }
        sc_merge(merged, SC_SCRIPT)
        for it in script
            if it.k == K_GINIT
                sc_merge(merged, it.a.c[3])
        if main.sc != None
            sc_merge(merged, main.sc)
        main.sc = merged
    ITEMS = rest

# an attribute that makes a function declare effects or capabilities (the
# attributes parse_func_body turns into decl / caps)
sc_attribute(a)
    return a == "pure" or a.starts_with("effects:") or a.starts_with("cap:")

# ── SemanticChecker.check_effects / check_capabilities ─────────────────────
sc_check()
    # self.funcs: functions and impl methods, in program order
    var funcs = {}
    var structs = {}
    var by_name = {}
    for it in ITEMS
        if it.k == K_FUNC
            funcs[it.a.name] = it.a
        elif it.k == K_STRUCTDEF or it.k == K_ENUMDEF
            structs[it.s] = 1
        elif it.k == K_IMPL
            for m in it.c
                let key = it.s + "." + m.name
                funcs[key] = m
                if not by_name.has(m.name)
                    by_name[m.name] = []
                by_name[m.name].push(key)
    # call edges [callee, line, precise]
    var edges = {}
    var inferred = {}
    for key in funcs
        let fi = funcs[key]
        var es = []
        var base = {}
        let sc = fi.sc
        if sc != None
            if sc.io > 0
                base["io"] = 1
            for ck in sc.calls
                let r = sc.calls[ck]
                if r[0] == 1
                    if funcs.has(r[1]) and not r[1].contains(".")
                        es.push([r[1], r[3], true])
                else
                    var done = false
                    if r[0] == 2
                        if MODULE_NAMES.has(r[1]) and not structs.has(r[1]) and funcs.has(r[2])
                            es.push([r[2], r[3], true])
                            done = true
                        elif structs.has(r[1])
                            let k2 = r[1] + "." + r[2]
                            if funcs.has(k2)
                                es.push([k2, r[3], true])
                            done = true
                        elif r[1] == "self" and key.contains(".")
                            let k2 = key.slice(0, key.find(".")) + "." + r[2]
                            if funcs.has(k2)
                                es.push([k2, r[3], true])
                                done = true
                    if not done
                        let cands = by_name.get_or(r[2], [])
                        for c in cands
                            es.push([c, r[3], len(cands) == 1])
            for name in sc.refs
                if funcs.has(name) and funcs[name].caps != None
                    es.push([name, sc.refs[name], true])
        edges[key] = es
        inferred[key] = base
    # interface effects: declared if present, else inferred (fixpoint)
    var changed = true
    while changed
        changed = false
        for key in funcs
            for e in edges[key]
                let ce = sc_effects(funcs, inferred, e[0])
                for eff in ce
                    if not inferred[key].has(eff)
                        inferred[key][eff] = 1
                        changed = true
    for key in funcs
        let fi = funcs[key]
        if fi.decl != None
            var allowed = {}
            for d in fi.decl
                allowed[d] = 1
            var actual = {}
            var via = {}
            if fi.sc != None and fi.sc.io > 0
                actual["io"] = fi.sc.io
            for e in edges[key]
                let ce = sc_effects(funcs, inferred, e[0])
                for eff in ce
                    if not allowed.has(eff) and not actual.has(eff)
                        actual[eff] = e[1]
                        via[eff] = e[0]
            var bad = []
            for eff in actual
                if not allowed.has(eff)
                    bad.push(eff)
            bad.sort()
            if len(bad) > 0
                let eff = bad[0]
                var how = ""
                if via.has(eff)
                    how = " (through the call to '" + via[eff] + "')"
                if fi.pure and len(fi.decl) == 0
                    fail_at(actual[eff], "pure function '" + key + "' performs effect '" + eff + "'" + how)
                var names = []
                for a in allowed
                    names.push(a)
                names.sort()
                var shown = names.join(", ")
                if len(shown) == 0
                    shown = "none"
                fail_at(actual[eff], "function '" + key + "' performs effect '" + eff + "'" + how + ", but declares only #[effects: " + shown + "]")
    for key in funcs
        if key != "main"
            var held = {}
            if funcs[key].caps != None
                for c in funcs[key].caps
                    held[c] = 1
            for e in edges[key]
                if e[2] and funcs[e[0]].caps != None
                    for c in funcs[e[0]].caps
                        if not held.has(c)
                            fail_at(e[1], "'" + key + "' uses '" + e[0] + "', which requires capability '" + c + "', but '" + key + "' does not hold it")

# effects of a callee: declared ones if any, else the inferred ones
sc_effects(funcs, inferred, callee)
    let d = funcs[callee].decl
    if d == None
        return inferred[callee]
    var m = {}
    for e in d
        m[e] = 1
    return m

# ── imports (ModuleResolver / resolve_imports): a module is looked for next
#    to the importing file and in the current directory (not in TIL_PATH or
#    the standard library: tilc cannot see them) ──────────────────────────
var MODULE_NAMES = {}
var MODULE_CACHE = {}

dir_of(path)
    var i = len(path) - 1
    while i >= 0 and path[i] != 47
        i -= 1
    return path.slice(0, i + 1)

# a/./b -> a/b, a/x/../b -> a/b
norm_path(p)
    var out = []
    for part in p.split("/")
        if part == "." or (part == "" and len(out) > 0)
            continue
        if part == ".." and len(out) > 0 and out[len(out) - 1] != ".." and out[len(out) - 1] != ""
            out.pop()
        else
            out.push(part)
    return out.join("/")

resolve_module(name, from_file)
    let parts = name.replace(".", "/")
    for d in [dir_of(from_file), ""]
        var cand = norm_path(d + parts + ".til")
        if file_exists(cand)
            return cand
        cand = norm_path(d + parts + "/mod.til")
        if file_exists(cand)
            return cand
    return None

# a module's top-level items (parsed and hoisted once), as [key, item] pairs
load_module(path)
    let cached = MODULE_CACHE.get_or(path, None)
    if cached != None
        return cached
    let save_name = FNAME
    FNAME = path
    let text = read_source(path)
    let save_items = ITEMS
    let save_attrs = PENDING_ATTRS
    let save_capt = SCRIPT_CAPT
    let save_sc = SC_SCRIPT
    ITEMS = []
    PENDING_ATTRS = []
    SCRIPT_CAPT = {}
    parse_program(setup_languages(text, path))
    hoist()
    var pairs = []
    var i = 0
    for it in ITEMS
        pairs.push([path + ":" + str(i), it])
        i += 1
    ITEMS = save_items
    PENDING_ATTRS = save_attrs
    SCRIPT_CAPT = save_capt
    SC_SCRIPT = save_sc
    FNAME = save_name
    MODULE_CACHE[path] = pairs
    return pairs

def_name(it)
    if it.k == K_FUNC
        return it.a.name
    return it.s

merge_imports(pairs, fname, stack)
    var out = []
    for pr in pairs
        let it = pr[1]
        if it.k != K_IMPORT
            out.push(pr)
        else
            let path = resolve_module(it.s, fname)
            if path == None
                FNAME = fname
                unsupported(it.ln, "import of '" + it.s + "' (module not found next to the importing file; tilc does not search TIL_PATH or the standard library)")
            let dot_parts = it.s.split(".")
            MODULE_NAMES[dot_parts[len(dot_parts) - 1]] = 1
            if it.b != None
                MODULE_NAMES[it.b] = 1
            if not stack.contains(path)
                var st2 = stack.copy()
                st2.push(path)
                for m in merge_imports(load_module(path), path, st2)
                    let node = m[1]
                    let k = node.k
                    if k == K_FUNC or k == K_STRUCTDEF or k == K_ENUMDEF or k == K_IMPL or k == K_TRAIT or k == K_TYPEALIAS or k == K_VAR
                        if not (k == K_FUNC and node.a.name == "main")
                            if it.c == None or it.c.contains(def_name(node))
                                out.push(m)
    return out

resolve_imports()
    var pairs = []
    var i = 0
    var any_import = false
    for it in ITEMS
        pairs.push(["#" + str(i), it])
        if it.k == K_IMPORT
            any_import = true
        i += 1
    if not any_import
        return
    let main_path = norm_path(FNAME)
    var seen = {}
    var out = []
    for pr in merge_imports(pairs, main_path, [main_path])
        if not seen.has(pr[0])
            seen[pr[0]] = 1
            out.push(pr[1])
    ITEMS = out

sc_merge(dst, src)
    if src == None
        return
    if dst.io == 0
        dst.io = src.io
    for k in src.calls
        if not dst.calls.has(k)
            dst.calls[k] = src.calls[k]
    for k in src.refs
        if not dst.refs.has(k)
            dst.refs[k] = src.refs[k]

# ═══════════════════════════════════════════════════════════════════════════
#                     BYTECODE COMPILER (BytecodeCompiler)
# ═══════════════════════════════════════════════════════════════════════════

struct FuncRec
    name: str
    np: int
    nreq: int
    nloc: int
    nup: int
    flags: int
    code: any
    lines: any
    off: int

# function being compiled (_FuncState)
# The code of a function is kept as bytes: the last ones in `code` (an
# array, at most ~520 elements), the earlier ones in the rope `cparts`
# (cbase bytes, as strings: one byte per byte instead of one VM value).
# A jump operand patched after its bytes went to `cparts` is recorded in
# `patches` ([position, low byte, high byte], sorted) and applied by
# finish_fs. The line table is built as bytes the same way (`lbuf`, `lines`).
struct FS
    rec: any
    fi: any
    owner: any
    code: any
    cbase: int
    cparts: any
    patches: any
    lines: any
    lbuf: any
    last: int
    scopes: any
    next: int
    loops: any
    tryd: int
    parent: any
    upvals: any
    captured: any
    rslot: any
    ens_on: bool

struct Loc
    slot: int
    mutable: bool
    cell: bool

struct LC
    breaks: any
    conts: any
    ctarget: any
    tryd: int

# compile-time constant: ty 0 int (small int or limbs), 1 float (8 bytes),
# 2 str, 3 bool
# x: for an int literal of 2^63 or more, its exact value (natural number
# limbs; Python's const_eval keeps literals exact), v is the wrapped value
struct CV
    ty: int
    v: any
    x: any

# the constant table: encoded constants in a rope (NCONSTS of them) and their
# indexes in 16 maps (a map of the C VM holds at most 32767 entries)
var CONSTS = new_rope()
var NCONSTS = 0
var CONST_IX = [{}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}, {}]
var USES_FLOAT = false
var FUNCS = []
var FUNC_IX = {}
var FDEFS = {}
var TYPES = []
var STRUCT_TYPES = {}
var STRUCT_FIELDS = {}
var ENUM_VALUES = {}
var ENUM_NAMES = {}
var ADT_VARIANTS = {}
var GLOBAL_SLOTS = {}
var GLOBAL_MUT = {}
var INLINE = {}
var GLOBALS = []
var METHOD_TBL = []
var USER_METHODS = {}
var METHODS_BY_NAME = {}
var FIELD_NAMES = {}
var PENDING = []
var PRELUDE = {}
var ENTRY = 0
var F = None
var SEM = false
var BINOPS = {"+": OP_ADD, "-": OP_SUB, "*": OP_MUL, "/": OP_DIV, "%": OP_MOD, "**": OP_POW,
    "&": OP_BAND, "|": OP_BOR, "^": OP_BXOR, "<<": OP_SHL, ">>": OP_SHR, "==": OP_EQ, "!=": OP_NE,
    "<": OP_LT, "<=": OP_LE, ">": OP_GT, ">=": OP_GE}

# ── constants ──────────────────────────────────────────────────────────────
const_add(enc)
    let n = len(enc)
    let ix = CONST_IX[(enc[n - 1] + enc[1] * 7 + n) % 16]
    let i = ix.get_or(enc, -1)
    if i >= 0
        return i
    let k = NCONSTS
    NCONSTS += 1
    # an index above 65535 is reported by put_h ("program too large")
    if k <= 65535
        radd(CONSTS, enc)
        ix[enc] = k
    return k

const_str(s)
    if len(s) > 65535
        fail_at(0, "string constant longer than 65535 bytes")
    return const_add("\x03" + u16s(len(s)) + s)

const_int(v)
    return const_add("\x01" + int_bytes(v))

const_float(b8)
    USES_FLOAT = true
    return const_add("\x02" + b8)

# ── emission ───────────────────────────────────────────────────────────────
# the bytes of `code` move to `cparts` (operands follow their instruction
# within a few bytes, so `code` never grows much beyond 512 elements)
code_flush(f)
    if len(f.code) > 0
        radd(f.cparts, bytes_to_str(f.code))
        f.cbase += len(f.code)
        f.code = []

emit(op, ln)
    let f = F
    if len(f.code) >= 512
        code_flush(f)
    if ln != 0 and ln != f.last
        let off = f.cbase + len(f.code)
        var l = ln
        if l > 65535
            l = 65535
        let lb = f.lbuf
        lb.push(off & 255)
        lb.push((off >> 8) & 255)
        lb.push((off >> 16) & 255)
        lb.push((off >> 24) & 255)
        lb.push(l & 255)
        lb.push(l >> 8)
        if len(lb) >= 510
            radd(f.lines, bytes_to_str(lb))
            f.lbuf = []
        f.last = ln
    f.code.push(op)

put_b(v, ln)
    if v < 0 or v > 255
        fail_at(ln, "operand out of range (" + str(v) + "); too many locals/arguments?")
    F.code.push(v)

put_h(v, ln)
    if v < 0 or v > 65535
        fail_at(ln, "program too large for the bytecode format")
    F.code.push(v & 255)
    F.code.push(v >> 8)

put_s(v)
    F.code.push(v & 255)
    F.code.push((v >> 8) & 255)

emit_b(op, v, ln)
    emit(op, ln)
    put_b(v, ln)

emit_h(op, v, ln)
    emit(op, ln)
    put_h(v, ln)

emit_hb(op, h, b, ln)
    emit(op, ln)
    put_h(h, ln)
    put_b(b, ln)

emit_bb(op, b1, b2, ln)
    emit(op, ln)
    put_b(b1, ln)
    put_b(b2, ln)

emit_jump(op, ln)
    emit(op, ln)
    put_s(0)
    return here() - 2

patch_to(at, target)
    let rel = target - (at + 2)
    if rel < -32768 or rel > 32767
        fail_at(0, "function too large: jump offset exceeds 32 KB")
    let f = F
    let i = at - f.cbase
    if i >= 0
        f.code[i] = rel & 255
        f.code[i + 1] = (rel >> 8) & 255
        return
    # already in cparts: insert into the sorted patch list
    let ps = f.patches
    var lo = 0
    var hi = len(ps)
    while lo < hi
        let mid = (lo + hi) / 2
        if ps[mid][0] < at
            lo = mid + 1
        else
            hi = mid
    ps.insert(lo, [at, rel & 255, (rel >> 8) & 255])

patch_jump(at)
    patch_to(at, here())

emit_loop(target, ln)
    emit(OP_JUMP, ln)
    put_s(0)
    patch_to(here() - 2, target)

here()
    return F.cbase + len(F.code)

push_int(v, ln)
    if not is_big(v)
        if v >= -128 and v <= 127
            emit(OP_PUSH_I8, ln)
            F.code.push(v & 255)
            return
        if v >= -32768 and v <= 32767
            emit(OP_PUSH_I16, ln)
            put_s(v)
            return
    emit_h(OP_PUSH_CONST, const_int(v), ln)

push_cv(c, ln)
    if c == None
        emit(OP_PUSH_NIL, ln)
    elif c.ty == 3
        if c.v
            emit(OP_PUSH_TRUE, ln)
        else
            emit(OP_PUSH_FALSE, ln)
    elif c.ty == 0
        push_int(c.v, ln)
    elif c.ty == 1
        emit_h(OP_PUSH_CONST, const_float(c.v), ln)
    else
        emit_h(OP_PUSH_CONST, const_str(c.v), ln)

# ── scopes and locals ──────────────────────────────────────────────────────
begin_scope()
    F.scopes.push({})

end_scope()
    F.scopes.pop()

declare_local(name, mut_, ln)
    let f = F
    let slot = f.next
    f.next += 1
    if f.next > 250
        fail_at(ln, "too many local variables in one function (max 250)")
    if f.next > f.rec.nloc
        f.rec.nloc = f.next
    let loc = Loc { slot: slot, mutable: mut_, cell: f.captured.has(name) }
    let sc = f.scopes
    sc[len(sc) - 1][name] = loc
    return loc

hidden_local()
    return declare_local(" tmp", true, 0).slot

find_local(name)
    return find_local_in(F, name)

find_local_in(fs, name)
    let sc = fs.scopes
    var i = len(sc) - 1
    while i >= 0
        let l = sc[i].get_or(name, None)
        if l != None
            return l
        i -= 1
    return None

# value on the stack -> a freshly declared local (in a cell if captured)
store_new_local(loc, ln)
    emit_b(OP_STORE_LOCAL, loc.slot, ln)
    if loc.cell
        emit_b(OP_MAKE_CELL, loc.slot, ln)

# upvalue index of `name` in function state fs, or -1 (resolve_upval)
resolve_upval(fs, name)
    if fs.parent == None
        return -1
    var i = 0
    while i < len(fs.upvals)
        if fs.upvals[i][0] == name
            return i
        i += 1
    let loc = find_local_in(fs.parent, name)
    if loc != None
        if not loc.cell
            return -1
        fs.upvals.push([name, true, loc.slot, loc.mutable])
        return len(fs.upvals) - 1
    let idx = resolve_upval(fs.parent, name)
    if idx < 0
        return -1
    fs.upvals.push([name, false, idx, fs.parent.upvals[idx][3]])
    return len(fs.upvals) - 1

shadowed(name)
    if find_local(name) != None
        return true
    for u in F.upvals
        if u[0] == name
            return true
    return false

# ── type helpers ───────────────────────────────────────────────────────────
numeric_cast(ty)
    if ty == None
        return -1
    if FLOAT_TYPES.has(ty)
        return 1
    if INT_TYPES.has(ty)
        return 0
    return -1

zero_value(ty)
    if ty == None
        return None
    if FLOAT_TYPES.has(ty)
        return CV { ty: 1, v: bytes_to_str([0, 0, 0, 0, 0, 0, 0, 0]) }
    if ty == "str"
        return CV { ty: 2, v: "" }
    if ty == "bool"
        return CV { ty: 3, v: false }
    if PRIM.has(ty) and ty != "void"
        return CV { ty: 0, v: 0 }
    return None

literal_cv(node)
    let k = node.k
    if k == K_INT
        return CV { ty: 0, v: node.n, x: node.s }
    if k == K_CHAR
        return CV { ty: 0, v: node.n }
    if k == K_FLOAT
        return CV { ty: 1, v: node.s }
    if k == K_STR
        return CV { ty: 2, v: node.s }
    return CV { ty: 3, v: node.n }

# ── constant folding (const_eval): None = not a constant ──────────────────
cv_truthy(c)
    if c.ty == 0
        if is_big(c.v) or c.x != None
            return true
        return c.v != 0
    if c.ty == 1
        return not float_is_zero(c.v)
    if c.ty == 2
        return len(c.v) > 0
    return c.v

# Python equality of two constants: 1 equal, 0 different, -1 unknown
cv_equal(a, b)
    if a.ty == 1 or b.ty == 1
        if a.ty == 2 or b.ty == 2
            return 0
        let x = ndecode(a)
        let y = ndecode(b)
        if x[0] == 3 or y[0] == 3
            return 0
        if fcmp(x, y) == 0
            return 1
        return 0
    if a.ty == 2 or b.ty == 2
        if a.ty == 2 and b.ty == 2 and a.v == b.v
            return 1
        return 0
    if a.x != None or b.x != None
        if fcmp(ndecode(a), ndecode(b)) == 0
            return 1
        return 0
    var x = a.v
    var y = b.v
    if a.ty == 3
        x = 0
        if a.v
            x = 1
    if b.ty == 3
        y = 0
        if b.v
            y = 1
    if i64_cmp(x, y) == 0
        return 1
    return 0

const_eval(node, env)
    let k = node.k
    if k == K_INT
        return CV { ty: 0, v: node.n, x: node.s }
    if k == K_CHAR
        return CV { ty: 0, v: node.n }
    if k == K_FLOAT
        return CV { ty: 1, v: node.s }
    if k == K_STR
        return CV { ty: 2, v: node.s }
    if k == K_BOOL
        return CV { ty: 3, v: node.n }
    if k == K_IDENT
        return env.get_or(node.s, None)
    if k == K_UN or k == K_BIN
        return chain_values(node, env, false)
    if k == K_CALL and node.a.k == K_IDENT and node.a.s == "len" and len(node.c) == 1
        let v = const_eval(node.c[0], env)
        if v != None and v.ty == 2
            return CV { ty: 0, v: len(v.v) }
    return None

# Operator chains (`1 + 2 + ... + n`, `- - x`): the parser builds them
# leaning left (unary: right), as deep as they are long. They are evaluated
# and compiled with loops so that a long flat expression does not need a
# deep VM call stack (only the other operands recurse).
op_chain(node)
    let k = node.k
    var chain = []
    var x = node
    while x.k == k
        chain.push(x)
        x = x.a
    return chain

# const_eval of the nodes of node's chain, from the innermost operand out.
# fold = false: the value of node. fold = true: [chain, m, value of chain[m],
# innermost operand], chain[m] being the outermost node that try_fold folds
# (m = len(chain): none). Only that value is kept (a long chain of string
# concatenations would otherwise hold every partial string).
chain_values(node, env, fold)
    let chain = op_chain(node)
    let n = len(chain)
    let inner = chain[n - 1].a
    var v = const_eval(inner, env)
    var m = n
    var mv = None
    var i = n - 1
    while i >= 0 and v != None
        if node.k == K_UN
            v = cv_unary(chain[i].s, v)
        else
            v = cv_binary(chain[i], v, env)
        if fold and foldable(v)
            m = i
            mv = v
        i -= 1
    if fold
        return [chain, m, mv, inner]
    return v

# const_eval of a unary operator applied to the constant v
cv_unary(op, v)
    if op == "-"
        if v.ty == 0
            return CV { ty: 0, v: i64_neg(v.v) }
        if v.ty == 1
            return CV { ty: 1, v: float_neg(v.v) }
        return None
    if op == "not"
        return CV { ty: 3, v: not cv_truthy(v) }
    if op == "~"
        if v.ty == 0
            return CV { ty: 0, v: i64_not(v.v) }
        if v.ty == 3
            if v.v
                return CV { ty: 0, v: -2 }
            return CV { ty: 0, v: -1 }
    return None

# const_eval of the binary operator node whose left operand has the value a
cv_binary(node, a, env)
    let op = node.s
    if op == "and" or op == "or"
        let ta = cv_truthy(a)
        if op == "and" and not ta
            return CV { ty: 3, v: false }
        if op == "or" and ta
            return CV { ty: 3, v: true }
        let b = const_eval(node.b, env)
        if b == None
            return None
        return CV { ty: 3, v: cv_truthy(b) }
    let b = const_eval(node.b, env)
    if b == None
        return None
    if op == "==" or op == "!="
        let e = cv_equal(a, b)
        if e < 0
            return None
        return CV { ty: 3, v: (e == 1) == (op == "==") }
    if (a.ty == 1 or b.ty == 1) and a.ty != 2 and b.ty != 2 and a.ty != 3 and b.ty != 3
        # int/float mix: comparisons are exact, arithmetic converts to float
        if op == "<" or op == ">" or op == "<=" or op == ">="
            let x = ndecode(a)
            let y = ndecode(b)
            if x[0] == 3 or y[0] == 3
                return CV { ty: 3, v: false }
            let c = fcmp(x, y)
            var r = c >= 0
            if op == "<"
                r = c < 0
            elif op == ">"
                r = c > 0
            elif op == "<="
                r = c <= 0
            return CV { ty: 3, v: r }
        var res = None
        let x = fvalue(a)
        let y = fvalue(b)
        if op == "+"
            res = fadd(x, y)
        elif op == "-"
            res = fadd(x, [y[0], 1 - y[1], y[2], y[3]])
        elif op == "*"
            res = fmul(x, y)
        elif op == "/"
            if fsign(ndecode(b)) == 0
                return None
            res = fdiv(x, y)
        if res == None
            return None
        return CV { ty: 1, v: res }
    if a.ty == 1 or b.ty == 1
        return None
    if a.ty == 0 and b.ty == 0
        let exact = a.x != None or b.x != None
        if op == "<" or op == ">" or op == "<=" or op == ">="
            var c = 0
            if exact
                c = fcmp(ndecode(a), ndecode(b))
            else
                c = i64_cmp(a.v, b.v)
            var r = c >= 0
            if op == "<"
                r = c < 0
            elif op == ">"
                r = c > 0
            elif op == "<="
                r = c <= 0
            return CV { ty: 3, v: r }
        if op == "+"
            return CV { ty: 0, v: i64_add(a.v, b.v) }
        if op == "-"
            return CV { ty: 0, v: i64_sub(a.v, b.v) }
        if op == "*"
            return CV { ty: 0, v: i64_mul(a.v, b.v) }
        if op == "/" or op == "%"
            if exact
                return exact_divmod(a, b, op)
            if i64_is_zero(b.v)
                return None
            let qr = i64_divmod(a.v, b.v)
            if op == "/"
                return CV { ty: 0, v: qr[0] }
            return CV { ty: 0, v: qr[1] }
        return None
    if op == "+" and a.ty == 2 and b.ty == 2
        return CV { ty: 2, v: a.v + b.v }
    return None

# til_idiv / til_imod when an operand is a literal of 2^63 or more: exact
# operands, the result wrapped to 64 bits
exact_divmod(a, b, op)
    let x = ndecode(a)
    let y = ndecode(b)
    if y[0] == 0
        return None
    if x[0] == 0
        return CV { ty: 0, v: 0 }
    let q = bn_divmod(x[2], y[2])[0]
    if op == "/"
        return CV { ty: 0, v: bn_wrap(q, x[1] != y[1]) }
    var r = bn_add(x[2], [])
    bn_subi(r, bn_mul(q, y[2]))
    return CV { ty: 0, v: bn_wrap(r, x[1] == 1) }

# (-1)^neg * m modulo 2^64 as a compile-time int
bn_wrap(m, neg)
    var a = [0, 0, 0, 0]
    var i = 0
    while i < 4 and i < len(m)
        a[i] = m[i]
        i += 1
    if neg
        a = i64_negl(a)
    return i64_norm(a)

# ── Python repr() of a compile-time constant (E-CONTRACT messages) ──────────
cv_repr(c)
    if c.ty == 3
        if c.v
            return "True"
        return "False"
    if c.ty == 0
        if c.x != None
            return bn_to_dec(c.x)
        return i64_dec(c.v)
    if c.ty == 2
        return py_str_repr(c.v)
    return float_repr(c.v)

i64_dec(v)
    if not is_big(v)
        return str(v)
    var a = i64_of(v)
    let neg = i64_isneg(a)
    if neg
        a = i64_negl(a)
    var digits = []
    while a[0] != 0 or a[1] != 0 or a[2] != 0 or a[3] != 0
        let qr = i64_divmodu(a, [10, 0, 0, 0])
        digits.push(str(qr[1][0]))
        a = qr[0]
    digits.reverse()
    if neg
        return "-" + digits.join("")
    return digits.join("")

hex2(c)
    let h = "0123456789abcdef"
    return h.slice(c >> 4, (c >> 4) + 1) + h.slice(c & 15, (c & 15) + 1)

py_str_repr(s)
    var q = "'"
    if s.contains("'") and not s.contains("\"")
        q = "\""
    var out = [q]
    var i = 0
    while i < len(s)
        let c = s[i]
        if c == 92
            out.push("\\\\")
        elif c == q[0]
            out.push("\\" + q)
        elif c == 10
            out.push("\\n")
        elif c == 13
            out.push("\\r")
        elif c == 9
            out.push("\\t")
        elif c < 32 or c == 127
            out.push("\\x" + hex2(c))
        elif c < 128
            out.push(s.slice(i, i + 1))
        else
            # str.isprintable() is false: \xhh, \uhhhh or \Uhhhhhhhh
            let k = ulen(c)
            let cp = ucp(s, i)
            if uprintable(cp)
                out.push(s.slice(i, i + k))
            elif cp < 256
                out.push("\\x" + hex2(cp))
            elif cp < 65536
                out.push("\\u" + hex2(cp >> 8) + hex2(cp & 255))
            else
                out.push("\\U00" + hex2(cp >> 16) + hex2((cp >> 8) & 255) + hex2(cp & 255))
            i += k - 1
        i += 1
    out.push(q)
    return out.join("")

# quotient and remainder of a natural by a small number
bn_divsmall(a, d)
    var q = []
    var i = 0
    while i < len(a)
        q.push(0)
        i += 1
    var r = 0
    i = len(a) - 1
    while i >= 0
        let t = r * 65536 + a[i]
        q[i] = t / d
        r = t % d
        i -= 1
    return [bn_trim(q), r]

bn_to_dec(a)
    if len(a) == 0
        return "0"
    var chunks = []
    var x = a
    while len(x) > 0
        let qr = bn_divsmall(x, 10000)
        chunks.push(qr[1])
        x = qr[0]
    var out = [str(chunks[len(chunks) - 1])]
    var i = len(chunks) - 2
    while i >= 0
        let s = str(chunks[i])
        out.push("0000".slice(0, 4 - len(s)) + s)
        i -= 1
    return out.join("")

# digits of ds rounded (half to even) to p digits: [digits, decimal point shift]
round_digits(ds, p)
    if len(ds) <= p
        return [ds, 0]
    var keep = str_bytes(ds.slice(0, p))
    let d = ds[p] - 48
    var rest = false
    var i = p + 1
    while i < len(ds)
        if ds[i] != 48
            rest = true
        i += 1
    var shift = 0
    if d > 5 or (d == 5 and (rest or (keep[p - 1] - 48) % 2 == 1))
        i = p - 1
        while i >= 0 and keep[i] == 57
            keep[i] = 48
            i -= 1
        if i < 0
            keep.insert(0, 49)
            keep.pop()
            shift = 1
        else
            keep[i] = keep[i] + 1
    var s = bytes_to_str(keep)
    var e = len(s)
    while e > 1 and s[e - 1] == 48
        e -= 1
    return [s.slice(0, e), shift]

# repr() of a double given as 8 bytes: the shortest digits that round-trip
float_repr(b8)
    var sign = ""
    if b8[7] >= 128
        sign = "-"
    let biased = ((b8[7] & 127) << 4) | (b8[6] >> 4)
    var M = bn_trim([b8[0] + b8[1] * 256, b8[2] + b8[3] * 256, b8[4] + b8[5] * 256, b8[6] & 15])
    if biased == 2047
        if len(M) == 0
            return sign + "inf"
        return "nan"
    var E = -1074
    if biased > 0
        while len(M) < 4
            M.push(0)
        M[3] = M[3] + 16
        E = biased - 1075
    if len(M) == 0
        return sign + "0.0"
    var N = M
    var k = 0
    if E >= 0
        N = bn_shl(M, E)
    else
        k = 0 - E
        var i = 0
        while i < k
            N = bn_muladd(N, 5, 0)
            i += 1
    let ds = bn_to_dec(N)
    var decpt = len(ds) - k
    var target = str_bytes(b8)
    target[7] = target[7] & 127
    let want = bytes_to_str(target)
    var digits = ds
    var p = 1
    while p <= 17
        let r = round_digits(ds, p)
        var D = []
        var j = 0
        while j < len(r[0])
            D = bn_muladd(D, 10, r[0][j] - 48)
            j += 1
        let dp = decpt + r[1]
        if float_bits_dec(D, dp - len(r[0]), len(r[0])) == want
            digits = r[0]
            decpt = dp
            break
        p += 1
    let nd = len(digits)
    if decpt > 16 or decpt < -3
        var m = digits.slice(0, 1)
        if nd > 1
            m = m + "." + digits.slice(1, nd)
        var e = decpt - 1
        var es = "+"
        if e < 0
            es = "-"
            e = 0 - e
        var ed = str(e)
        if len(ed) < 2
            ed = "0" + ed
        return sign + m + "e" + es + ed
    if decpt <= 0
        return sign + "0." + "0".repeat(0 - decpt) + digits
    if decpt >= nd
        return sign + digits + "0".repeat(decpt - nd) + ".0"
    return sign + digits.slice(0, decpt) + "." + digits.slice(decpt, nd)

# a folded nan is left to run time: its bits in the Python compiler depend on
# the CPU (only the comparisons and truthiness of a nan are folded)
try_fold(node)
    let c = const_eval(node, INLINE)
    if c != None and c.ty == 1 and float_is_nan(c.v)
        return None
    return c

# ── errors ─────────────────────────────────────────────────────────────────
unknown_name(ln, name, what)
    fail_at(ln, "unknown " + what + " '" + name + "'")

# ── program ────────────────────────────────────────────────────────────────
add_function(name, fi, owner)
    let idx = len(FUNCS)
    FUNCS.push(FuncRec { name: name })
    FUNC_IX[name] = idx
    FDEFS[name] = fi
    PENDING.push([idx, fi, owner])
    return idx

new_fs(rec, fi, owner)
    var capt = {}
    if fi != None and fi.capt != None
        capt = fi.capt
    F = FS { rec: rec, fi: fi, owner: owner, code: [], cparts: new_rope(), patches: [], lines: new_rope(),
             lbuf: [], last: -1, scopes: [{}], next: 0, loops: [], tryd: 0, upvals: [], captured: capt }

finish_fs()
    let f = F
    code_flush(f)
    var code = rjoin(f.cparts)
    if len(f.patches) > 0
        let out = new_rope()
        var at = 0
        for pt in f.patches
            radd(out, code.slice(at, pt[0]))
            radd(out, bytes_to_str([pt[1], pt[2]]))
            at = pt[0] + 2
        radd(out, code.slice(at, len(code)))
        code = rjoin(out)
    f.rec.code = code
    radd(f.lines, bytes_to_str(f.lbuf))
    f.rec.lines = rjoin(f.lines)

declare_enum(it)
    var is_adt = false
    for v in it.c
        if v.nf > 0
            is_adt = true
    ENUM_NAMES[it.s] = 1
    if is_adt
        var vm = {}
        for v in it.c
            var fl = []
            var i = 0
            while i < v.nf
                fl.push(str(i))
                FIELD_NAMES[str(i)] = 1
                i += 1
            vm[v.name] = [len(TYPES), v.nf]
            TYPES.push([it.s + "." + v.name, fl])
        ADT_VARIANTS[it.s] = vm
        return
    var vals = {}
    var nxt = 0
    for v in it.c
        if v.value != None
            let c = const_eval(v.value, {})
            if c == None
                fail_at(v.value.ln, "enum values must be constants")
            if c.ty == 3
                nxt = 0
                if c.v
                    nxt = 1
            elif c.ty == 0
                nxt = c.v
            else
                unsupported(v.value.ln, "non-integer enum value")
        vals[v.name] = nxt
        nxt = i64_add(nxt, 1)
    ENUM_VALUES[it.s] = vals

compile_program()
    TYPES = [["Some", ["value"]], ["Ok", ["value"]], ["Err", ["error"]]]
    FIELD_NAMES["value"] = 1
    FIELD_NAMES["error"] = 1
    var impls = []
    var globals = []
    var traits = {}
    for it in ITEMS
        if it.k == K_TRAIT
            traits[it.s] = it
        if it.k == K_STRUCTDEF
            STRUCT_TYPES[it.s] = len(TYPES)
            STRUCT_FIELDS[it.s] = it.c
            var names = []
            for fld in it.c
                names.push(fld.name)
                FIELD_NAMES[fld.name] = 1
            TYPES.push([it.s, names])
        elif it.k == K_ENUMDEF
            declare_enum(it)
        elif it.k == K_IMPL
            impls.push(it)
        elif it.k == K_VAR
            globals.push(it)
    for it in ITEMS
        if it.k == K_FUNC
            let fi = it.a
            if FUNC_IX.has(fi.name)
                fail_at(it.ln, "function '" + fi.name + "' is defined twice")
            add_function(fi.name, fi, None)
    for im in impls
        if not STRUCT_TYPES.has(im.s)
            fail_at(im.ln, "impl for unknown struct '" + im.s + "'")
        let tidx = STRUCT_TYPES[im.s]
        for m in im.c
            let key = im.s + "." + m.name
            let fidx = add_function(key, m, im.s)
            USER_METHODS[m.name] = 1
            if not METHODS_BY_NAME.has(m.name)
                METHODS_BY_NAME[m.name] = []
            METHODS_BY_NAME[m.name].push(key)
            var has_self = false
            for p in m.params
                if p.name == "self"
                    has_self = true
            if has_self
                METHOD_TBL.push([tidx, const_str(m.name), fidx])
        # trait default methods, compiled for this type
        if im.b != None and traits.has(im.b)
            var defined = {}
            for m in im.c
                defined[m.name] = 1
            for tm in traits[im.b].c
                if not defined.has(tm.name)
                    if tm.nstmts <= 0
                        fail_at(im.ln, "impl " + im.b + " for " + im.s + " is missing method '" + tm.name + "'")
                    let fidx = add_function(im.s + "." + tm.name, tm, im.s)
                    PENDING[len(PENDING) - 1].push(false)
                    USER_METHODS[tm.name] = 1
                    var has_self = false
                    for p in tm.params
                        if p.name == "self"
                            has_self = true
                    if has_self
                        METHOD_TBL.push([tidx, const_str(tm.name), fidx])
    for g in globals
        if (g.n & 1) == 0 and g.a != None
            INLINE[g.s] = literal_cv(g.a)
        else
            GLOBAL_SLOTS[g.s] = len(GLOBALS)
            GLOBAL_MUT[g.s] = (g.n & 1) != 0
            GLOBALS.push(g.s)
    # entry point: initialise globals, then call main
    let start = FuncRec { name: "__start__" }
    ENTRY = len(FUNCS)
    FUNCS.push(start)
    new_fs(start, None, None)
    for g in globals
        if GLOBAL_SLOTS.has(g.s) and (g.n & 4) == 0
            if g.c != None
                relex_at(g.c[4], g.c[0], g.c[1], 0)
                cexpr(parse_expression())
            else
                emit(OP_PUSH_NIL, 0)
            emit_h(OP_STORE_GLOBAL, GLOBAL_SLOTS[g.s], g.ln)
    if FUNC_IX.has("main")
        emit_hb(OP_CALL, FUNC_IX["main"], 0, 0)
        emit(OP_POP, 0)
    emit(OP_HALT, 0)
    finish_fs()
    var i = 0
    while i < len(PENDING)
        compile_function(PENDING[i])
        i += 1

# the body of a function, re-read from its source position
# restart the lexer at a saved source position (top level: indentation
# stack [0]; impl methods: [0, ind])
relex_at(sf, pos, line, ind)
    var stack = [0]
    if ind > 0
        stack = [0, ind]
    new_stream(new_lexer(sf, pos, line, stack, false))

# function body at the current token: block, { ... } or => expression
# function body at the current token: block, { ... } or => expression.
# Returns the number of statements (-1: none, a trait method signature)
func_body_c(allow_sig)
    skip_nl()
    if TK.t == T_INDENT
        return block_c()
    if TK.t == T_LBRACE
        return brace_c()
    if TK.t == T_FAT_ARROW
        let fat = adv()
        let e = parse_expression()
        if not DRY
            cexpr(e)
            emit_return_value(fat.ln)
        return 1
    if allow_sig
        return -1
    perr("Expected function body")

compile_function(pe)
    let rec = FUNCS[pe[0]]
    let fi = pe[1]
    new_fs(rec, fi, pe[2])
    let params = fi.params
    let np = len(params)
    rec.np = np
    rec.nreq = 0
    var seen = false
    var i = 0
    while i < np
        let p = params[i]
        if p.def == None and not seen
            rec.nreq = i + 1
        elif p.def != None
            seen = true
        i += 1
    if fi.name == "main" and np > 0
        fail_at(fi.ln, "main() takes no parameters")
    if np > 0 and params[0].name == "self"
        rec.flags = rec.flags | 1
    if fi.ret == "Option" or fi.ret == "Result"
        rec.flags = rec.flags | 2
    for p in params
        declare_local(p.name, true, fi.ln)
    i = 0
    while i < np
        if params[i].def != None
            emit_b(OP_ARG_DEFAULT, i, fi.ln)
            put_s(0)
            let at = here() - 2
            cexpr(params[i].def)
            emit_b(OP_STORE_LOCAL, i, 0)
            patch_jump(at)
        i += 1
    i = 0
    while i < np
        let c = numeric_cast(params[i].ty)
        if c >= 0
            emit_b(OP_LOAD_LOCAL, i, 0)
            emit_b(OP_CAST, c, 0)
            emit_b(OP_STORE_LOCAL, i, 0)
        i += 1
    for p in params
        let loc = find_local(p.name)
        if loc.cell
            emit_b(OP_MAKE_CELL, loc.slot, 0)
    if fi.req != None
        for r in fi.req
            cexpr(r[0])
            let skip = emit_jump(OP_JUMP_IF_TRUE, r[0].ln)
            emit_h(OP_PUSH_CONST, const_str(strip_ws("contract violation: " + fi.name + " requires " + r[1])), r[0].ln)
            emit(OP_PANIC, r[0].ln)
            patch_jump(skip)
    # body: script statements first (script mode), then the function's own
    SEM = not fi.prelude and len(pe) < 4
    begin_scope()
    if fi.pre != None
        for item in fi.pre
            script_item_c(item)
    if not fi.synth
        relex_at(fi.src, fi.bpos, fi.bline, fi.bind)
        func_body_c(false)
    end_scope()
    SEM = false
    emit_return_nil(fi.ln)
    finish_fs()

script_item_c(item)
    if item.k == K_GINIT
        let d = item.a
        relex_at(d.c[4], d.c[0], d.c[1], 0)
        cexpr(parse_expression())
        let c = numeric_cast(d.b)
        if c >= 0
            emit_b(OP_CAST, c, item.ln)
        emit_h(OP_STORE_GLOBAL, GLOBAL_SLOTS[d.s], item.ln)
    else
        relex_at(item.c[2], item.c[0], item.c[1], 0)
        stmt_c()
        var k = 1
        while k < item.c[3]
            skip_nl()
            stmt_c()
            k += 1

# ── statements: parsed and compiled in one go (only expressions are trees),
#    in the order of Parser.parse_statement + BytecodeCompiler.compile_stmt.
#    With DRY set (first pass) nothing is compiled. ──────────────────────────
stmt_c()
    skip_nl()
    let tok = TK
    let t = tok.t
    var cls = 0
    if t == T_IF
        if if_c(false)
            cls = 3
    elif t == T_FOR
        for_c(tok.ln)
    elif t == T_WHILE
        while_c(tok.ln)
    elif t == T_LOOP
        loop_c(tok.ln)
    elif t == T_RETURN
        return_c(tok.ln)
    elif t == T_BREAK or t == T_CONTINUE
        adv()
        if not DRY
            cbreak(tok.ln, t == T_BREAK)
    elif t == T_LET or t == T_VAR or t == T_CONST
        vardecl_c(tok.ln, t)
    elif t == T_ASSERT or t == T_INVARIANT
        assert_c(tok.ln, t)
    elif t == T_MATCH
        let m = parse_match()
        if m.ln == 0
            m.ln = tok.ln
        if not DRY
            cmatch(m, false)
        cls = 2
    elif t == T_INTENT
        intent_c(false)
        cls = 4
    elif t == T_PERFORM
        unsupported(tok.ln, "perform (effects)")
    else
        let expr = parse_expression()
        let u = TK.t
        if u == T_EQ or u == T_PLUSEQ or u == T_MINUSEQ or u == T_STAREQ or u == T_SLASHEQ or u == T_PERCENTEQ
            let op = adv()
            let value = parse_expression()
            if not DRY
                cassign(expr, op.v, value, op.ln)
        else
            cls = 1
            if not DRY
                cexpr(expr)
                emit(OP_POP, 0)
    LAST_STMT = cls

# body of if/elif/else/for/while/loop (a scope of its own)
body_c()
    if not DRY
        begin_scope()
    if TK.t == T_INDENT
        block_c()
    elif TK.t == T_LBRACE
        brace_c()
    else
        stmt_c()
    if not DRY
        end_scope()

block_c()
    expect(T_INDENT)
    var n = 0
    while TK.t != T_DEDENT and TK.t != T_EOF
        skip_nl()
        if TK.t == T_DEDENT or TK.t == T_EOF
            break
        stmt_c()
        n += 1
        skip_nl()
    if TK.t == T_DEDENT
        adv()
    return n

brace_c()
    expect(T_LBRACE)
    skip_nl()
    var n = 0
    while TK.t != T_RBRACE and TK.t != T_EOF
        stmt_c()
        n += 1
        skip_nl()
        if TK.t == T_SEMICOLON
            adv()
        skip_nl()
    expect(T_RBRACE)
    return n

# if / elif / else; want_value: the branches are value blocks
# (compile_if(want_value=True)). Returns whether there was an else branch.
if_c(want_value)
    adv()
    var cond = parse_expression()
    skip_nl()
    var ends = []
    var nxt = 0
    if not DRY
        cexpr(cond)
        nxt = emit_jump(OP_JUMP_IF_FALSE, cond.ln)
    # (branch: inlined, one call frame less per nested block)
    if want_value and not DRY
        value_body_c()
    else
        body_c()
    if not DRY
        ends.push(emit_jump(OP_JUMP, 0))
        patch_jump(nxt)
    skip_nl()
    while TK.t == T_ELIF or (TK.t == T_ELSE and peek(1).t == T_IF)
        if TK.t == T_ELSE
            adv()
        adv()
        cond = parse_expression()
        skip_nl()
        if not DRY
            cexpr(cond)
            nxt = emit_jump(OP_JUMP_IF_FALSE, cond.ln)
        if want_value and not DRY
            value_body_c()
        else
            body_c()
        if not DRY
            ends.push(emit_jump(OP_JUMP, 0))
            patch_jump(nxt)
        skip_nl()
    var has_else = false
    if TK.t == T_ELSE
        adv()
        skip_nl()
        if want_value and not DRY
            value_body_c()
        else
            body_c()
        has_else = true
    elif want_value and not DRY
        emit(OP_PUSH_NIL, 0)
    if not DRY
        for e in ends
            patch_jump(e)
    return has_else

# ── blocks used as values (compile_block_value): retry/timeout bodies, the
#    branches of an if that is the last statement of such a block ──────────

# a copy of the token stream (lexer state included) to read ahead or replay
fork_stream()
    let ts = TSG
    let lx = ts.lx
    let l2 = Lx { sf: lx.sf, src: lx.src, n: lx.n, pos: lx.pos, line: lx.line, stack: lx.stack.copy(),
                  atls: lx.atls, paren: lx.paren, q: lx.q.slice(lx.qh, len(lx.q)), qh: 0,
                  done: lx.done, tsp: lx.tsp, tln: lx.tln }
    return TS { lx: l2, buf: ts.buf.slice(ts.p, len(ts.buf)), p: 0 }

# dry run on a fork: [number of statements, kind of the last one] of the
# block / brace block / single statement at the current token
prescan_body()
    let saved = TSG
    let saved_tk = TK
    let saved_dry = DRY
    TSG = fork_stream()
    TK = peek(0)
    DRY = true
    var n = 0
    if TK.t == T_INDENT
        adv()
        while TK.t != T_DEDENT and TK.t != T_EOF
            skip_nl()
            if TK.t == T_DEDENT or TK.t == T_EOF
                break
            stmt_c()
            n += 1
            skip_nl()
    elif TK.t == T_LBRACE
        adv()
        skip_nl()
        while TK.t != T_RBRACE and TK.t != T_EOF
            stmt_c()
            n += 1
            skip_nl()
            if TK.t == T_SEMICOLON
                adv()
            skip_nl()
    else
        stmt_c()
        n = 1
    let cls = LAST_STMT
    TSG = saved
    TK = saved_tk
    DRY = saved_dry
    return [n, cls]

value_body_c()
    let info = prescan_body()
    let n = info[0]
    begin_scope()
    if n == 0
        emit(OP_PUSH_NIL, 0)
    if TK.t == T_INDENT
        adv()
        var i = 0
        while TK.t != T_DEDENT and TK.t != T_EOF
            skip_nl()
            if TK.t == T_DEDENT or TK.t == T_EOF
                break
            if i == n - 1
                stmt_value_c(info[1])
            else
                stmt_c()
            i += 1
            skip_nl()
        if TK.t == T_DEDENT
            adv()
    elif TK.t == T_LBRACE
        adv()
        skip_nl()
        var i = 0
        while TK.t != T_RBRACE and TK.t != T_EOF
            if i == n - 1
                stmt_value_c(info[1])
            else
                stmt_c()
            i += 1
            skip_nl()
            if TK.t == T_SEMICOLON
                adv()
            skip_nl()
        expect(T_RBRACE)
    else
        stmt_value_c(info[1])
    end_scope()

# the last statement of a value block leaves its value on the stack
stmt_value_c(cls)
    skip_nl()
    let tok = TK
    if cls == 1
        cexpr(parse_expression())
    elif cls == 2
        let m = parse_match()
        if m.ln == 0
            m.ln = tok.ln
        cmatch(m, true)
    elif cls == 3
        if_c(true)
    elif cls == 4
        intent_c(true)
    else
        stmt_c()
        emit(OP_PUSH_NIL, 0)

# a block inside an expression (retry/timeout body or else): remember a fork
# of the token stream to compile it later, and skip it now
block_ref()
    var f = None
    if not DRY
        f = fork_stream()
    let saved_dry = DRY
    DRY = true
    block_c()
    DRY = saved_dry
    let r = mk(K_FORK, 0)
    r.a = f
    return r

# compile a remembered block as a value
replay_value_block(r)
    let saved = TSG
    let saved_tk = TK
    TSG = r.a
    r.a = fork_stream()
    TK = peek(0)
    value_body_c()
    TSG = saved
    TK = saved_tk

# intent "goal" body (compile_intent)
intent_c(want_value)
    let tok = adv()
    let desc = expect(T_STRING).v
    skip_nl()
    if DRY
        if TK.t == T_INDENT
            block_c()
        else
            parse_expression()
        return
    let handler = emit_jump(OP_TRY, tok.ln)
    F.tryd += 1
    if TK.t == T_INDENT
        if want_value
            value_body_c()
        else
            begin_scope()
            block_c()
            end_scope()
    else
        cexpr(parse_expression())
        if not want_value
            emit(OP_POP, 0)
    F.tryd -= 1
    emit(OP_END_TRY, 0)
    let done = emit_jump(OP_JUMP, 0)
    patch_jump(handler)
    emit_h(OP_PUSH_CONST, const_str("intent '" + desc + "' failed: "), tok.ln)
    emit(OP_SWAP, 0)
    emit_b(OP_CONCAT, 2, 0)
    emit(OP_PANIC, tok.ln)
    patch_jump(done)

guarded_body(b)
    F.tryd += 1
    if b.k == K_FORK
        replay_value_block(b)
    else
        cexpr(b)
    F.tryd -= 1

# `else` branch of retry/timeout: the error message is bound to `error`
cfallback(fb, err, ln)
    if fb == None
        emit_b(OP_LOAD_LOCAL, err, 0)
        emit(OP_PANIC, ln)
        return
    begin_scope()
    let loc = declare_local("error", false, ln)
    emit_b(OP_LOAD_LOCAL, err, 0)
    store_new_local(loc, ln)
    if fb.k == K_FORK
        replay_value_block(fb)
    else
        cexpr(fb)
    end_scope()

# retry(n) body else fallback: run the body again after a runtime error
cretry(node)
    begin_scope()
    let limit = hidden_local()
    let count = hidden_local()
    let err = hidden_local()
    cexpr(node.a)
    emit_b(OP_STORE_LOCAL, limit, 0)
    emit(OP_PUSH_I8, 0)
    F.code.push(0)
    emit_b(OP_STORE_LOCAL, count, 0)
    let top = here()
    let handler = emit_jump(OP_TRY, node.ln)
    guarded_body(node.b)
    emit(OP_END_TRY, 0)
    let done = emit_jump(OP_JUMP, 0)
    patch_jump(handler)
    emit_b(OP_STORE_LOCAL, err, 0)
    emit_b(OP_LOAD_LOCAL, count, 0)
    emit(OP_PUSH_I8, 0)
    F.code.push(1)
    emit(OP_ADD, 0)
    emit(OP_DUP, 0)
    emit_b(OP_STORE_LOCAL, count, 0)
    emit_b(OP_LOAD_LOCAL, limit, 0)
    emit(OP_LT, 0)
    let again = emit_jump(OP_JUMP_IF_TRUE, node.ln)
    patch_to(again, top)
    cfallback(node.c, err, node.ln)
    patch_jump(done)
    end_scope()

# timeout(ms) body else fallback
ctimeout(node)
    begin_scope()
    let err = hidden_local()
    cexpr(node.a)
    let handler = emit_jump(OP_TRY_TIMEOUT, node.ln)
    guarded_body(node.b)
    emit(OP_END_TRY, 0)
    let done = emit_jump(OP_JUMP, 0)
    patch_jump(handler)
    emit_b(OP_STORE_LOCAL, err, 0)
    cfallback(node.c, err, node.ln)
    patch_jump(done)
    end_scope()

while_c(ln)
    adv()
    let cond = parse_expression()
    skip_nl()
    if DRY
        body_c()
        return
    let top = here()
    cexpr(cond)
    let exit_jump = emit_jump(OP_JUMP_IF_FALSE, ln)
    let ctx = push_loop(top)
    body_c()
    emit_loop(top, ln)
    patch_jump(exit_jump)
    pop_loop(ctx)

loop_c(ln)
    adv()
    skip_nl()
    if DRY
        body_c()
        return
    let top = here()
    let ctx = push_loop(top)
    body_c()
    emit_loop(top, ln)
    pop_loop(ctx)

return_c(ln)
    adv()
    var value = None
    let u = TK.t
    if u != T_NEWLINE and u != T_DEDENT and u != T_EOF and u != T_RBRACE
        value = parse_expression()
    if DRY
        return
    var i = 0
    while i < F.tryd
        emit(OP_END_TRY, 0)
        i += 1
    if value != None
        cexpr(value)
        emit_return_value(ln)
    else
        emit_return_nil(ln)

vardecl_c(ln, t)
    adv()
    let name = expect(T_IDENT).v
    var ty = None
    if TK.t == T_COLON
        adv()
        ty = parse_type()
    var value = None
    if TK.t == T_EQ
        adv()
        value = parse_expression()
    if DRY
        return
    if value == None
        push_cv(zero_value(ty), ln)
    else
        cexpr(value)
        let c = numeric_cast(ty)
        if c >= 0
            var lit = value.k == K_FLOAT
            if c == 0
                lit = value.k == K_INT
            if not lit
                emit_b(OP_CAST, c, ln)
    store_new_local(declare_local(name, t == T_VAR, ln), ln)

assert_c(ln, t)
    adv()
    let cond = parse_expression()
    var msg = None
    if TK.t == T_COMMA
        adv()
        msg = expect(T_STRING).v
    if DRY
        return
    cexpr(cond)
    let ok = emit_jump(OP_JUMP_IF_TRUE, ln)
    var kind = "Assertion failed"
    if t == T_INVARIANT
        kind = "Invariant violated"
    if msg != None and len(msg) > 0
        kind = kind + ": " + msg
    emit_h(OP_PUSH_CONST, const_str(kind), ln)
    emit(OP_PANIC, ln)
    patch_jump(ok)

struct FC
    rng: bool
    v: any
    top: int
    jmp: int
    lc: any

load_loc(loc, ln)
    if loc.cell
        emit_b(OP_LOAD_CELL, loc.slot, ln)
    else
        emit_b(OP_LOAD_LOCAL, loc.slot, ln)

store_loc(loc, ln)
    if loc.cell
        emit_b(OP_STORE_CELL, loc.slot, ln)
    else
        emit_b(OP_STORE_LOCAL, loc.slot, ln)

for_c(ln)
    adv()
    let vname = expect(T_IDENT).v
    expect(T_IN)
    let it = parse_expression()
    skip_nl()
    if DRY
        body_c()
        return
    let fc = for_begin(vname, it, ln)
    body_c()
    for_end(fc, ln)

# BytecodeCompiler.compile_for, split around the body
for_begin(vname, it, ln)
    begin_scope()
    if it.k == K_RANGE
        cexpr(it.a)
        let v = declare_local(vname, true, ln)
        store_new_local(v, ln)
        cexpr(it.b)
        let end_slot = hidden_local()
        emit_b(OP_STORE_LOCAL, end_slot, 0)
        let top = here()
        load_loc(v, ln)
        emit_b(OP_LOAD_LOCAL, end_slot, 0)
        if it.n
            emit(OP_LE, 0)
        else
            emit(OP_LT, 0)
        let jmp = emit_jump(OP_JUMP_IF_FALSE, ln)
        return FC { rng: true, v: v, top: top, jmp: jmp, lc: push_loop(None) }
    cexpr(it)
    emit_bb(OP_NATIVE, N_ITER, 1, ln)
    let its = hidden_local()
    let idx = hidden_local()
    emit_b(OP_STORE_LOCAL, its, 0)
    emit(OP_PUSH_I8, 0)
    F.code.push(0)
    emit_b(OP_STORE_LOCAL, idx, 0)
    let top = here()
    emit_b(OP_FOR_ITER, its, ln)
    put_s(0)
    let at = here() - 2
    let v = declare_local(vname, true, ln)
    store_new_local(v, ln)
    return FC { rng: false, v: v, top: top, jmp: at, lc: push_loop(top) }

for_end(fc, ln)
    if fc.rng
        for c in fc.lc.conts
            patch_jump(c)
        load_loc(fc.v, 0)
        emit(OP_PUSH_I8, 0)
        F.code.push(1)
        emit(OP_ADD, 0)
        store_loc(fc.v, 0)
    emit_loop(fc.top, ln)
    patch_jump(fc.jmp)
    pop_loop(fc.lc)
    end_scope()

# [expr for x in iter if cond] (compile_comprehension: a for loop pushing
# into a hidden array; the code is that of the desugared AST)
ccomprehension(node)
    begin_scope()
    emit_h(OP_NEW_ARRAY, 0, node.ln)
    let res = hidden_local()
    emit_b(OP_STORE_LOCAL, res, 0)
    let sc = F.scopes
    sc[len(sc) - 1][" res"] = Loc { slot: res, mutable: false, cell: false }
    let fc = for_begin(node.s, node.b, node.ln)
    begin_scope()
    var nxt = -1
    if node.c != None
        cexpr(node.c)
        nxt = emit_jump(OP_JUMP_IF_FALSE, node.c.ln)
        begin_scope()
    let saved = SEM
    SEM = false
    emit_b(OP_LOAD_LOCAL, res, node.ln)
    cexpr(node.a)
    emit_h(OP_INVOKE, const_str("push"), node.ln)
    put_b(1, node.ln)
    put_b(1, node.ln)
    SEM = saved
    emit(OP_POP, 0)
    if node.c != None
        end_scope()
        let endj = emit_jump(OP_JUMP, 0)
        patch_jump(nxt)
        patch_jump(endj)
    end_scope()
    for_end(fc, node.ln)
    emit_b(OP_LOAD_LOCAL, res, 0)
    end_scope()

# |params| body -> a new function; captured variables become upvalues
clambda(node)
    let rec = FuncRec { name: "<lambda:" + str(node.ln) + ">", flags: 4 }
    let fidx = len(FUNCS)
    FUNCS.push(rec)
    let parent = F
    var capt = {}
    lambda_captures(node.a, capt)
    F = FS { rec: rec, owner: parent.owner, code: [], cparts: new_rope(), patches: [], lines: new_rope(),
             lbuf: [], last: -1, scopes: [{}], next: 0, loops: [], tryd: 0, parent: parent, upvals: [],
             captured: capt }
    let np = len(node.c)
    rec.np = np
    rec.nreq = np
    for p in node.c
        declare_local(p, true, node.ln)
    for p in node.c
        let loc = find_local(p)
        if loc.cell
            emit_b(OP_MAKE_CELL, loc.slot, 0)
    cexpr(node.a)
    emit(OP_RETURN, node.ln)
    let ups = F.upvals
    rec.nup = len(ups)
    finish_fs()
    F = parent
    if len(ups) == 0
        emit_h(OP_PUSH_FUNC, fidx, node.ln)
        return
    for u in ups
        if u[1]
            emit_b(OP_LOAD_LOCAL, u[2], node.ln)
        else
            emit_b(OP_LOAD_UPVAL_RAW, u[2], node.ln)
    emit_hb(OP_MAKE_CLOSURE, fidx, len(ups), node.ln)

# ── pattern matching (compile_match / compile_pattern / destructure) ───────
cmatch(node, want_value)
    begin_scope()
    cexpr(node.a)
    let subj = hidden_local()
    emit_b(OP_STORE_LOCAL, subj, 0)
    var ends = []
    for arm in node.c
        begin_scope()
        var fails = []
        cpattern(arm[0], subj, fails)
        if arm[1] != None
            cexpr(arm[1])
            fails.push(emit_jump(OP_JUMP_IF_FALSE, arm[1].ln))
        cexpr(arm[2])
        if not want_value
            emit(OP_POP, 0)
        ends.push(emit_jump(OP_JUMP, 0))
        for f in fails
            patch_jump(f)
        end_scope()
    if want_value
        emit(OP_PUSH_NIL, 0)
    for e in ends
        patch_jump(e)
    end_scope()

# (type index, arity) of constructor patterns Some(x), Point(a, b), E.V(x)
pattern_type(c)
    if c.k == K_IDENT
        if c.s == "Some"
            return [0, 1]
        if c.s == "Ok"
            return [1, 1]
        if c.s == "Err"
            return [2, 1]
        if STRUCT_TYPES.has(c.s)
            return [STRUCT_TYPES[c.s], len(STRUCT_FIELDS[c.s])]
    if c.k == K_ATTR and c.a.k == K_IDENT
        let vs = ADT_VARIANTS.get_or(c.a.s, None)
        if vs != None and vs.has(c.s)
            return vs[c.s]
    return None

compare_with(pat, subj, fails)
    emit_b(OP_LOAD_LOCAL, subj, 0)
    cexpr(pat)
    emit(OP_EQ, 0)
    fails.push(emit_jump(OP_JUMP_IF_FALSE, pat.ln))

match_type(subj, t, ln, fails)
    emit_b(OP_LOAD_LOCAL, subj, 0)
    emit_h(OP_MATCH_TYPE, t, 0)
    fails.push(emit_jump(OP_JUMP_IF_FALSE, ln))

cpattern(pat, subj, fails)
    let k = pat.k
    if k == K_IDENT
        let name = pat.s
        if name == "_"
            return
        if name == "NULL"
            emit_b(OP_LOAD_LOCAL, subj, 0)
            emit(OP_PUSH_NIL, 0)
            emit(OP_EQ, 0)
            fails.push(emit_jump(OP_JUMP_IF_FALSE, pat.ln))
            return
        if find_local(name) == None and (INLINE.has(name) or GLOBAL_SLOTS.has(name))
            compare_with(pat, subj, fails)
            return
        let loc = declare_local(name, false, pat.ln)
        emit_b(OP_LOAD_LOCAL, subj, 0)
        store_new_local(loc, pat.ln)
        return
    if k == K_ATTR and pat.a.k == K_IDENT and ADT_VARIANTS.has(pat.a.s)
        let variant = ADT_VARIANTS[pat.a.s].get_or(pat.s, None)
        if variant == None
            fail_at(pat.ln, "enum '" + pat.a.s + "' has no variant '" + pat.s + "'")
        match_type(subj, variant[0], pat.ln, fails)
        return
    if k == K_CALL
        let info = pattern_type(pat.a)
        if info == None
            compare_with(pat, subj, fails)
            return
        if len(pat.c) != info[1]
            fail_at(pat.ln, "pattern expects " + str(info[1]) + " field(s), got " + str(len(pat.c)))
        match_type(subj, info[0], pat.ln, fails)
        destructure(pat.c, None, subj, fails)
        return
    if k == K_TUPLE or k == K_ARRAY
        emit_b(OP_LOAD_LOCAL, subj, 0)
        emit_h(OP_IS_ARRAY_LEN, len(pat.c), 0)
        fails.push(emit_jump(OP_JUMP_IF_FALSE, pat.ln))
        destructure(pat.c, None, subj, fails)
        return
    if k == K_SINIT and STRUCT_TYPES.has(pat.s)
        match_type(subj, STRUCT_TYPES[pat.s], pat.ln, fails)
        var names = []
        var subs = []
        for f in pat.c
            names.push(f)
            subs.push(pat.c[f])
        destructure(subs, names, subj, fails)
        return
    if k == K_RANGE
        emit_b(OP_LOAD_LOCAL, subj, 0)
        cexpr(pat.a)
        emit(OP_GE, 0)
        fails.push(emit_jump(OP_JUMP_IF_FALSE, pat.ln))
        emit_b(OP_LOAD_LOCAL, subj, 0)
        cexpr(pat.b)
        if pat.n
            emit(OP_LE, 0)
        else
            emit(OP_LT, 0)
        fails.push(emit_jump(OP_JUMP_IF_FALSE, pat.ln))
        return
    if k == K_BIN and pat.s == "|"
        var alts = []
        var stack = [pat]
        while len(stack) > 0
            let p = stack.pop()
            if p.k == K_BIN and p.s == "|"
                stack.push(p.b)
                stack.push(p.a)
            else
                alts.push(p)
        var oks = []
        for alt in alts
            emit_b(OP_LOAD_LOCAL, subj, 0)
            cexpr(alt)
            emit(OP_EQ, 0)
            oks.push(emit_jump(OP_JUMP_IF_TRUE, alt.ln))
        fails.push(emit_jump(OP_JUMP, pat.ln))
        for o in oks
            patch_jump(o)
        return
    compare_with(pat, subj, fails)

destructure(subs, names, subj, fails)
    var i = 0
    while i < len(subs)
        let sub = subs[i]
        if not (sub.k == K_IDENT and sub.s == "_")
            let tmp = hidden_local()
            emit_b(OP_LOAD_LOCAL, subj, 0)
            if names == None
                emit_b(OP_GET_SLOT, i, 0)
            else
                emit_h(OP_GET_FIELD, const_str(names[i]), 0)
            emit_b(OP_STORE_LOCAL, tmp, 0)
            cpattern(sub, tmp, fails)
        i += 1

cbreak(ln, is_break)
    if len(F.loops) == 0
        if is_break
            fail_at(ln, "'break' outside of a loop")
        fail_at(ln, "'continue' outside of a loop")
    let ctx = F.loops[len(F.loops) - 1]
    var i = 0
    while i < F.tryd - ctx.tryd
        emit(OP_END_TRY, 0)
        i += 1
    if is_break
        ctx.breaks.push(emit_jump(OP_JUMP, ln))
    elif ctx.ctarget != None
        emit_loop(ctx.ctarget, ln)
    else
        ctx.conts.push(emit_jump(OP_JUMP, ln))

cassign(target, op, value, ln)
    var bop = -1
    if op != "="
        bop = BINOPS[op.slice(0, len(op) - 1)]
    if target.k == K_IDENT
        if bop >= 0
            if not emit_load_var(target.s, target.ln)
                unknown_name(target.ln, target.s, "name")
            cexpr(value)
            emit(bop, ln)
        else
            cexpr(value)
        emit_store_var(target.s, ln)
    elif target.k == K_INDEX
        cexpr(target.a)
        cexpr(target.b)
        if bop >= 0
            emit(OP_DUP2, 0)
            emit(OP_GET_INDEX, target.ln)
            cexpr(value)
            emit(bop, ln)
        else
            cexpr(value)
        emit(OP_SET_INDEX, ln)
    elif target.k == K_ATTR
        cexpr(target.a)
        let name = const_str(target.s)
        if bop >= 0
            emit(OP_DUP, 0)
            emit_h(OP_GET_FIELD, name, target.ln)
            cexpr(value)
            emit(bop, ln)
        else
            cexpr(value)
        emit_h(OP_SET_FIELD, name, ln)
    else
        fail_at(ln, "invalid assignment target")

emit_return_nil(ln)
    let fi = F.fi
    if fi != None and fi.ens != None and len(fi.ens) > 0 and fi.ret != "void"
        emit(OP_PUSH_NIL, 0)
        emit_return_value(ln)
    else
        emit(OP_RETURN_NIL, ln)

# return the value on the stack, checking #[ensures] first
emit_return_value(ln)
    let fi = F.fi
    if fi != None
        let c = numeric_cast(fi.ret)
        if c >= 0
            emit_b(OP_CAST, c, ln)
        if fi.ens != None and len(fi.ens) > 0
            if F.rslot == None
                F.rslot = hidden_local()
            emit_b(OP_STORE_LOCAL, F.rslot, ln)
            F.ens_on = true
            for e in fi.ens
                cexpr(e[0])
                let ok = emit_jump(OP_JUMP_IF_TRUE, e[0].ln)
                emit_h(OP_PUSH_CONST, const_str(strip_ws("contract violation: " + fi.name + " ensures " + e[1])), e[0].ln)
                emit(OP_PANIC, e[0].ln)
                patch_jump(ok)
            F.ens_on = false
            emit_b(OP_LOAD_LOCAL, F.rslot, 0)
    emit(OP_RETURN, ln)

prelude_function(meth)
    let mid = METHOD_ID[meth]
    if PRELUDE.has(mid)
        return PRELUDE[mid]
    let save_ts = TSG
    let save_tk = TK
    let sf = setup_languages(PRELUDE_SRC[meth], "<prelude>")
    let save_dry = DRY
    DRY = true
    new_stream(new_lexer(sf, 0, 1, [0], true))
    let fi = parse_func_simple(sf, 0).a
    DRY = save_dry
    TSG = save_ts
    TK = save_tk
    fi.prelude = true
    let idx = add_function(fi.name, fi, None)
    PRELUDE[mid] = idx
    return idx

# ── statements ─────────────────────────────────────────────────────────────
emit_load_var(name, ln)
    if F.ens_on and name == "result"
        emit_b(OP_LOAD_LOCAL, F.rslot, ln)
        return true
    let loc = find_local(name)
    if loc != None
        if loc.cell
            emit_b(OP_LOAD_CELL, loc.slot, ln)
        else
            emit_b(OP_LOAD_LOCAL, loc.slot, ln)
        return true
    let up = resolve_upval(F, name)
    if up >= 0
        emit_b(OP_LOAD_UPVAL, up, ln)
        return true
    let c = INLINE.get_or(name, None)
    if c != None
        push_cv(c, ln)
        return true
    if GLOBAL_SLOTS.has(name)
        emit_h(OP_LOAD_GLOBAL, GLOBAL_SLOTS[name], ln)
        return true
    return false

emit_store_var(name, ln)
    let loc = find_local(name)
    if loc != None
        if not loc.mutable
            fail_at(ln, "cannot assign twice to immutable variable '" + name + "'")
        if loc.cell
            emit_b(OP_STORE_CELL, loc.slot, ln)
        else
            emit_b(OP_STORE_LOCAL, loc.slot, ln)
        return
    let up = resolve_upval(F, name)
    if up >= 0
        if not F.upvals[up][3]
            fail_at(ln, "cannot assign to immutable captured variable '" + name + "'")
        emit_b(OP_STORE_UPVAL, up, ln)
        return
    if GLOBAL_SLOTS.has(name)
        if not GLOBAL_MUT[name]
            fail_at(ln, "cannot assign to immutable global '" + name + "'")
        emit_h(OP_STORE_GLOBAL, GLOBAL_SLOTS[name], ln)
        return
    if INLINE.has(name)
        fail_at(ln, "cannot assign to constant '" + name + "'")
    unknown_name(ln, name, "name")

push_loop(ctarget)
    let ctx = LC { breaks: [], conts: [], ctarget: ctarget, tryd: F.tryd }
    F.loops.push(ctx)
    return ctx

pop_loop(ctx)
    F.loops.pop()
    for b in ctx.breaks
        patch_jump(b)

# ── expressions ────────────────────────────────────────────────────────────
cexpr(node)
    let k = node.k
    if k == K_IDENT
        cident(node)
    elif k == K_INT
        push_int(node.n, node.ln)
    elif k == K_CALL
        ccall(node)
    elif k == K_STR
        emit_h(OP_PUSH_CONST, const_str(node.s), node.ln)
    elif k == K_ATTR
        cattr(node)
    elif k == K_BIN
        cbinary(node)
    elif k == K_INDEX
        cexpr(node.a)
        cexpr(node.b)
        emit(OP_GET_INDEX, node.ln)
    elif k == K_UN
        cunary(node)
    elif k == K_FSTR
        cfstring(node)
    elif k == K_BOOL
        if node.n
            emit(OP_PUSH_TRUE, node.ln)
        else
            emit(OP_PUSH_FALSE, node.ln)
    elif k == K_CHAR
        push_int(node.n, node.ln)
    elif k == K_FLOAT
        emit_h(OP_PUSH_CONST, const_float(node.s), node.ln)
    elif k == K_ARRAY or k == K_TUPLE
        for e in node.c
            cexpr(e)
        emit_h(OP_NEW_ARRAY, len(node.c), node.ln)
    elif k == K_DICT
        for e in node.c
            cexpr(e)
        emit_h(OP_NEW_MAP, len(node.c) / 2, node.ln)
    elif k == K_SINIT
        cstruct_init(node)
    elif k == K_RANGE
        cexpr(node.a)
        cexpr(node.b)
        if node.n
            emit(OP_PUSH_TRUE, 0)
        else
            emit(OP_PUSH_FALSE, 0)
        emit_bb(OP_NATIVE, N_RANGE, 3, node.ln)
    elif k == K_IFX
        cexpr(node.a)
        let jf = emit_jump(OP_JUMP_IF_FALSE, node.ln)
        cexpr(node.b)
        let end = emit_jump(OP_JUMP, 0)
        patch_jump(jf)
        if node.c != None
            cexpr(node.c)
        else
            emit(OP_PUSH_NIL, 0)
        patch_jump(end)
    elif k == K_CAST
        cexpr(node.a)
        let ty = node.s
        if PRIM.has(ty) and ty != "void"
            var kind = 0
            if FLOAT_TYPES.has(ty)
                kind = 1
            elif ty == "str"
                kind = 2
            elif ty == "bool"
                kind = 3
            emit_b(OP_CAST, kind, node.ln)
    elif k == K_NULLCHK
        cexpr(node.a)
        if (F.rec.flags & 2) != 0
            emit(OP_UNWRAP_OR_RETURN, node.ln)
        else
            emit(OP_UNWRAP_OR_PANIC, node.ln)
    elif k == K_LAMBDA
        clambda(node)
    elif k == K_MATCH
        cmatch(node, true)
    elif k == K_LISTCOMP
        ccomprehension(node)
    elif k == K_RETRY
        cretry(node)
    elif k == K_TIMEOUT
        ctimeout(node)
    else
        fail_at(node.ln, "internal error: cannot compile node kind " + str(k))

cident(node)
    let name = node.s
    if name == "NULL"
        emit(OP_PUSH_NIL, node.ln)
        return
    if emit_load_var(name, node.ln)
        return
    if FUNC_IX.has(name) and not name.contains(".")
        emit_h(OP_PUSH_FUNC, FUNC_IX[name], node.ln)
        return
    if STRUCT_TYPES.has(name) or ENUM_VALUES.has(name)
        fail_at(node.ln, "'" + name + "' is a type, not a value")
    unknown_name(node.ln, name, "name")

# a constant that try_fold would return (a nan is left to run time)
foldable(c)
    return c != None and not (c.ty == 1 and float_is_nan(c.v))

# The recursive compile_expr: a node that folds is pushed as a constant, else
# its operand is compiled, then the operator. For a chain of operators this
# is done with loops: the outermost node that folds is pushed (or the
# innermost operand compiled), then the operators around it, inside out.
cunary(node)
    let cv = chain_values(node, INLINE, true)
    let chain = cv[0]
    let m = cv[1]
    if m < len(chain)
        push_cv(cv[2], chain[m].ln)
    else
        cexpr(cv[3])
    var i = m - 1
    while i >= 0
        let op = chain[i].s
        if op == "-"
            emit(OP_NEG, chain[i].ln)
        elif op == "not"
            emit(OP_NOT, chain[i].ln)
        elif op == "~"
            emit(OP_BNOT, chain[i].ln)
        i -= 1

cbinary(node)
    let cv = chain_values(node, INLINE, true)
    let chain = cv[0]
    let m = cv[1]
    var k = 0
    while k < m
        let op = chain[k].s
        if op != "and" and op != "or" and BINOPS.get_or(op, -1) < 0
            fail_at(chain[k].ln, "unsupported operator '" + op + "'")
        k += 1
    if m < len(chain)
        push_cv(cv[2], chain[m].ln)
    else
        cexpr(cv[3])
    var i = m - 1
    while i >= 0
        cbinary_rest(chain[i])
        i -= 1

# the rest of a binary operator once its left operand is on the stack
cbinary_rest(node)
    let op = node.s
    if op == "and" or op == "or"
        var jop = OP_JUMP_IF_FALSE
        var first = OP_PUSH_TRUE
        var second = OP_PUSH_FALSE
        if op == "or"
            jop = OP_JUMP_IF_TRUE
            first = OP_PUSH_FALSE
            second = OP_PUSH_TRUE
        let j1 = emit_jump(jop, node.ln)
        cexpr(node.b)
        let j2 = emit_jump(jop, node.ln)
        emit(first, 0)
        let end = emit_jump(OP_JUMP, 0)
        patch_jump(j1)
        patch_jump(j2)
        emit(second, 0)
        patch_jump(end)
        return
    cexpr(node.b)
    emit(BINOPS[op], node.ln)

cargs(args, ln)
    if len(args) > 255
        fail_at(ln, "too many arguments (max 255)")
    for a in args
        cexpr(a)

expects_text(required, n)
    if required == n
        return str(required)
    return str(required) + " to " + str(n)

check_arity(ln, name, argc)
    let fi = FDEFS.get_or(name, None)
    if fi == None
        return
    var n = 0
    var required = 0
    for p in fi.params
        if p.name != "self"
            n += 1
            if p.def == None
                required += 1
    if argc < required or argc > n
        fail_at(ln, "'" + name + "' expects " + expects_text(required, n) + " argument(s), got " + str(argc))

# SemanticChecker.check_call_site (arity of resolved calls in function bodies)
sem_check(key, node)
    if not SEM
        return
    let fi = FDEFS.get_or(key, None)
    if fi == None
        return
    var n = 0
    var required = 0
    for p in fi.params
        if p.name != "self"
            n += 1
            if p.def == None
                required += 1
    let f = node.a
    let inst = f.k == K_ATTR and not (f.a.k == K_IDENT and (STRUCT_TYPES.has(f.a.s) or MODULE_NAMES.has(f.a.s)))
    if len(fi.params) != n and not inst
        return
    let argc = len(node.c)
    if argc < required or argc > n
        fail_at(node.ln, "'" + key + "' expects " + expects_text(required, n) + " argument(s), got " + str(argc))
    if fi.req == None or len(fi.req) == 0
        return
    var env = {}
    for k in SEM_CONSTS
        env[k] = SEM_CONSTS[k]
    var i = 0
    for p in fi.params
        if p.name != "self"
            var arg = p.def
            if i < argc
                arg = node.c[i]
            let v = const_eval(arg, SEM_CONSTS)
            if v == None
                return
            env[p.name] = v
            i += 1
    for r in fi.req
        let ok = const_eval(r[0], env)
        if ok != None and not cv_truthy(ok)
            var shown = []
            for p in fi.params
                if p.name != "self"
                    shown.push(p.name + "=" + cv_repr(env[p.name]))
            fail_at(node.ln, "contract violation: call to '" + key + "' (" + shown.join(", ") + ") breaks #[requires: " + r[1] + "]")

# SemanticChecker.resolve_call for obj.meth(...) calls compiled as INVOKE
sem_check_method(node, obj, meth)
    if not SEM
        return
    if obj.k == K_IDENT
        if STRUCT_TYPES.has(obj.s) or ENUM_NAMES.has(obj.s)
            let key = obj.s + "." + meth
            if FDEFS.has(key)
                sem_check(key, node)
            return
        if obj.s == "self" and F.owner != None
            let key = F.owner + "." + meth
            if FDEFS.has(key)
                sem_check(key, node)
                return
    let cands = METHODS_BY_NAME.get_or(meth, None)
    if cands != None and len(cands) == 1
        sem_check(cands[0], node)

ccall(node)
    let f = node.a
    let args = node.c
    let argc = len(args)
    if f.k == K_IDENT
        let name = f.s
        if shadowed(name)
            emit_load_var(name, f.ln)
            cargs(args, node.ln)
            emit_b(OP_CALL_VALUE, argc, node.ln)
            return
        if FUNC_IX.has(name) and not name.contains(".")
            sem_check(name, node)
            check_arity(node.ln, name, argc)
            cargs(args, node.ln)
            emit_hb(OP_CALL, FUNC_IX[name], argc, node.ln)
            return
        if STRUCT_TYPES.has(name)
            let nf = len(STRUCT_FIELDS[name])
            if argc != nf
                fail_at(node.ln, "'" + name + "(...)' needs " + str(nf) + " field value(s), got " + str(argc))
            cargs(args, node.ln)
            emit_hb(OP_NEW_STRUCT, STRUCT_TYPES[name], argc, node.ln)
            return
        if name == "Some" or name == "Ok" or name == "Err"
            if argc > 1
                fail_at(node.ln, name + "(...) takes one value")
            cargs(args, node.ln)
            if argc == 0
                emit(OP_PUSH_NIL, 0)
            var t = 0
            if name == "Ok"
                t = 1
            elif name == "Err"
                t = 2
            emit_hb(OP_NEW_STRUCT, t, 1, node.ln)
            return
        if GLOBAL_SLOTS.has(name)
            emit_h(OP_LOAD_GLOBAL, GLOBAL_SLOTS[name], f.ln)
            cargs(args, node.ln)
            emit_b(OP_CALL_VALUE, argc, node.ln)
            return
        let nid = NATIVE_ID.get_or(name, -1)
        if nid >= 0
            let lo = NAT_MIN[nid]
            let hi = NAT_MAX[nid]
            if argc < lo or (hi >= 0 and argc > hi)
                var want = "at least " + str(lo)
                if lo == hi
                    want = str(lo)
                elif hi >= 0
                    want = str(lo) + " to " + str(hi)
                fail_at(node.ln, "'" + name + "' takes " + want + " argument(s), got " + str(argc))
            if nid == N_RANGE and argc == 1
                emit(OP_PUSH_I8, node.ln)
                F.code.push(0)
                cargs(args, node.ln)
                emit(OP_PUSH_FALSE, 0)
                emit_bb(OP_NATIVE, N_RANGE, 3, node.ln)
                return
            cargs(args, node.ln)
            emit_bb(OP_NATIVE, nid, argc, node.ln)
            return
        unknown_name(f.ln, name, "function")
    if f.k == K_ATTR
        let obj = f.a
        let meth = f.s
        if obj.k == K_IDENT and not shadowed(obj.s)
            let oname = obj.s
            if STRUCT_TYPES.has(oname)
                let key = oname + "." + meth
                if not FUNC_IX.has(key)
                    fail_at(node.ln, "struct '" + oname + "' has no function '" + meth + "'")
                sem_check(key, node)
                check_arity(node.ln, key, argc)
                cargs(args, node.ln)
                emit_hb(OP_CALL, FUNC_IX[key], argc, node.ln)
                return
            if ADT_VARIANTS.has(oname)
                let variant = ADT_VARIANTS[oname].get_or(meth, None)
                if variant == None
                    fail_at(node.ln, "enum '" + oname + "' has no variant '" + meth + "'")
                if argc != variant[1]
                    fail_at(node.ln, "'" + oname + "." + meth + "' takes " + str(variant[1]) + " value(s), got " + str(argc))
                cargs(args, node.ln)
                emit_hb(OP_NEW_STRUCT, variant[0], argc, node.ln)
                return
            if MODULE_NAMES.has(oname) and not GLOBAL_SLOTS.has(oname)
                if not FUNC_IX.has(meth)
                    fail_at(node.ln, "module '" + oname + "' has no function '" + meth + "'")
                sem_check(meth, node)
                check_arity(node.ln, meth, argc)
                cargs(args, node.ln)
                emit_hb(OP_CALL, FUNC_IX[meth], argc, node.ln)
                return
            # Vec<T>.new() / HashMap<K,V>.new(): the SemanticChecker still
            # resolves `.new` by name (a user `new` method gets its arity checked)
            if oname.starts_with("__Vec__") and meth == "new"
                sem_check_method(node, obj, meth)
                emit_h(OP_NEW_ARRAY, 0, node.ln)
                return
            if oname.starts_with("__HashMap__") and meth == "new"
                sem_check_method(node, obj, meth)
                emit_h(OP_NEW_MAP, 0, node.ln)
                return
        let mid = METHOD_ID.get_or(meth, 255)
        if mid == 255 and not USER_METHODS.has(meth) and not FIELD_NAMES.has(meth)
            fail_at(node.ln, "unknown method '" + meth + "'")
        if PRELUDE_SRC.has(meth)
            prelude_function(meth)
        sem_check_method(node, obj, meth)
        cexpr(obj)
        cargs(args, node.ln)
        emit_h(OP_INVOKE, const_str(meth), node.ln)
        put_b(mid, node.ln)
        put_b(argc, node.ln)
        return
    cexpr(f)
    cargs(args, node.ln)
    emit_b(OP_CALL_VALUE, argc, node.ln)

cattr(node)
    let obj = node.a
    if obj.k == K_IDENT and not shadowed(obj.s)
        let oname = obj.s
        if ENUM_VALUES.has(oname)
            let vals = ENUM_VALUES[oname]
            if not vals.has(node.s)
                fail_at(node.ln, "enum '" + oname + "' has no variant '" + node.s + "'")
            push_int(vals[node.s], node.ln)
            return
        if ADT_VARIANTS.has(oname)
            let variant = ADT_VARIANTS[oname].get_or(node.s, None)
            if variant == None
                fail_at(node.ln, "enum '" + oname + "' has no variant '" + node.s + "'")
            if variant[1] != 0
                fail_at(node.ln, "'" + oname + "." + node.s + "' needs " + str(variant[1]) + " value(s)")
            emit_hb(OP_NEW_STRUCT, variant[0], 0, node.ln)
            return
        if MODULE_NAMES.has(oname) and not GLOBAL_SLOTS.has(oname)
            let id = mk(K_IDENT, node.ln)
            id.s = node.s
            cexpr(id)
            return
    cexpr(obj)
    emit_h(OP_GET_FIELD, const_str(node.s), node.ln)

cstruct_init(node)
    let name = node.s
    if not STRUCT_TYPES.has(name)
        unknown_name(node.ln, name, "struct")
    let fields = STRUCT_FIELDS[name]
    let given = node.c
    for g in given
        var found = false
        for fld in fields
            if fld.name == g
                found = true
        if not found
            fail_at(node.ln, "struct '" + name + "' has no field '" + g + "'")
    let saved = SEM
    SEM = false
    for fld in fields
        if given.has(fld.name)
            let e = given[fld.name]
            cexpr(e)
            if FLOAT_TYPES.has(fld.ty) and e.k != K_FLOAT
                emit_b(OP_CAST, 1, 0)
        elif fld.def != None
            cexpr(fld.def)
        else
            push_cv(zero_value(fld.ty), node.ln)
    SEM = saved
    emit_hb(OP_NEW_STRUCT, STRUCT_TYPES[name], len(fields), node.ln)

cfstring(node)
    var count = 0
    for part in node.c
        if part.k == K_STR
            emit_h(OP_PUSH_CONST, const_str(part.s), node.ln)
        else
            cexpr(part.a)
            if part.s != None
                emit_h(OP_PUSH_CONST, const_str(part.s), 0)
                emit_bb(OP_NATIVE, N_FORMAT, 2, node.ln)
        count += 1
    if count == 0
        emit_h(OP_PUSH_CONST, const_str(""), node.ln)
    elif count > 255
        fail_at(node.ln, "f-string has too many parts")
    else
        emit_b(OP_CONCAT, count, node.ln)

# ═══════════════════════════════════════════════════════════════════════════
#                     SERIALIZATION (TBCModule.to_bytes)
# ═══════════════════════════════════════════════════════════════════════════

serialize()
    for f in FUNCS
        const_str(f.name)
    for t in TYPES
        const_str(t[0])
        for fld in t[1]
            const_str(fld)
    if NCONSTS > 65535
        fail_at(0, "program too large for the bytecode format")
    # link: one code section
    var off = 0
    var nlines = 0
    for f in FUNCS
        f.off = off
        off += len(f.code)
        nlines += len(f.lines) / 6
    let out = new_rope()
    var flags = 2
    if USES_FLOAT
        flags = 3
    radd(out, "TILB" + bytes_to_str([2, flags]))
    radd(out, u16s(len(GLOBALS)) + u16s(ENTRY))
    radd(out, u16s(NCONSTS))
    radd(out, rjoin(CONSTS))
    radd(out, u16s(len(FUNCS)))
    for f in FUNCS
        radd(out, u16s(const_str(f.name)) + bytes_to_str([f.np, f.nreq, f.nloc, f.nup, f.flags]) + u32s(f.off))
    radd(out, u16s(len(TYPES)))
    for t in TYPES
        var rec = u16s(const_str(t[0])) + bytes_to_str([len(t[1])])
        for fld in t[1]
            rec = rec + u16s(const_str(fld))
        radd(out, rec)
    # methods sorted by (type, name constant) - stable insertion sort
    var ms = []
    for m in METHOD_TBL
        var i = len(ms)
        ms.push(m)
        while i > 0 and (ms[i - 1][0] > m[0] or (ms[i - 1][0] == m[0] and ms[i - 1][1] > m[1]))
            ms[i] = ms[i - 1]
            i -= 1
        ms[i] = m
    radd(out, u16s(len(ms)))
    for m in ms
        radd(out, u16s(m[0]) + u16s(m[1]) + u16s(m[2]))
    var mids = []
    for mid in PRELUDE
        mids.push(mid)
    mids.sort()
    radd(out, bytes_to_str([len(mids)]))
    for mid in mids
        radd(out, bytes_to_str([mid]) + u16s(PRELUDE[mid]))
    radd(out, u32s(off))
    for f in FUNCS
        radd(out, f.code)
        f.code = None
    if nlines > 65535
        nlines = 65535
    radd(out, u16s(nlines))
    var left = nlines
    for f in FUNCS
        let ls = f.lines
        var i = 0
        while i < len(ls) and left > 0
            let pc = ls[i] + ls[i + 1] * 256 + ls[i + 2] * 65536 + ls[i + 3] * 16777216 + f.off
            radd(out, u32s(pc) + ls.slice(i + 4, i + 6))
            left -= 1
            i += 6
    return rjoin(out)

# ═══════════════════════════════════════════════════════════════════════════
#                                  DRIVER
# ═══════════════════════════════════════════════════════════════════════════

main()
    init_tables()
    let a = args()
    if len(a) != 2
        print("usage: tilc INPUT.til OUTPUT.tbc")
        exit(2)
    FNAME = a[0]
    if not file_exists(a[0])
        print("tilc: cannot read " + a[0])
        exit(1)
    let src = read_source(a[0])
    MAIN_SF = setup_languages(src, a[0])
    parse_program(MAIN_SF)
    hoist()
    resolve_imports()
    if SC_ON
        sc_check()
    TSG = None
    TK = None
    compile_program()
    # the sources and the declarations are not needed any more
    ITEMS = []
    PENDING = []
    FDEFS = {}
    MODULE_CACHE = {}
    MAIN_SF = None
    TSG = None
    TK = None
    F = None
    let err = try_write(a[1], serialize())
    if err != None
        print("tilc: cannot write " + a[1] + " (" + err + ")")
        exit(1)
