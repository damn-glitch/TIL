#[lang: ru]
# TIL на русском языке

структура Точка
    x: float
    y: float

функция расстояние(а: Точка, б: Точка) -> float
    пусть dx = б.x - а.x
    пусть dy = б.y - а.y
    вернуть sqrt(dx * dx + dy * dy)

функция факториал(н: int) -> int
    если н <= 1
        вернуть 1
    вернуть н * факториал(н - 1)

главная()
    печать("Привет, мир!")
    для i в 1..4
        если i % 2 == 0
            печать(f"{i} - чётное")
        иначе
            печать(f"{i} - нечётное")
    печать(факториал(10))
    пусть а = Точка { x: 0.0, y: 0.0 }
    пусть б = Точка { x: 3.0, y: 4.0 }
    печать(расстояние(а, б))
    перем счёт = 0
    пока счёт < 3
        счёт += 1
    печать(счёт == 3 и истина)
