#[lang: ru]
# Программа на TIL с русскими ключевыми словами.

функция факториал(н: int) -> int
    если н <= 1
        вернуть 1
    вернуть н * факториал(н - 1)

функция чётное(н: int) -> bool
    вернуть н % 2 == 0

печать("Привет, мир!")
для i в 1..=5
    если чётное(i)
        печать(f"{i} - чётное")
    иначе
        печать(f"{i} - нечётное")

перем счёт = 0
пока счёт < 3
    счёт += 1
печать(f"счёт = {счёт}")
печать(f"10! = {факториал(10)}")
