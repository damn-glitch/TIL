# Қазақ тіліндегі кілт сөздер (Kazakh keywords - always available).

қосу(а: int, б: int) -> int
    қайтару а + б

факториал(н: int) -> int
    егер н <= 1
        қайтару 1
    қайтару н * факториал(н - 1)

print("Сәлем, Әлем!")
тұрақты нәтиже = қосу(3, 4)
print(f"3 + 4 = {нәтиже}")

айнымалы қосынды = 0
үшін и ішінде 1..=5
    қосынды += и
print(f"1 + 2 + 3 + 4 + 5 = {қосынды}")

үшін н ішінде 1..=6
    print(f"{н}! = {факториал(н)}")
